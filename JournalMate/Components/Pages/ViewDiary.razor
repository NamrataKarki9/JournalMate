@code {
    private List<JournalEntry> JournalRecords = new();
    private bool IsFetchingData = true;
    private string TitleSearchQuery = "";
    private bool DisplayDeleteConfirmation = false;
    private string TargetDeleteDateKey = "";
    private bool IsDeletionInProgress = false;

    private List<JournalEntry> FilteredRecordsList =>
        string.IsNullOrWhiteSpace(TitleSearchQuery)
            ? JournalRecords
            : JournalRecords.Where(record =>
                record.Title.Contains(TitleSearchQuery, StringComparison.OrdinalIgnoreCase)
              ).ToList();

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += StateHasChanged;
        await LoadEntries();
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }

    private async Task LoadEntries()
    {
        IsFetchingData = true;
        try
        {
            JournalRecords = await Db.GetRecentAsync(500);
        }
        finally
        {
            IsFetchingData = false;
        }
    }

    private void UpdateSearchFilter(ChangeEventArgs eventArgs)
    {
        TitleSearchQuery = eventArgs?.Value?.ToString() ?? "";
    }

    private void NavigateToEditor(string dateKey)
    {
        var targetUrl = $"/diary?date={Uri.EscapeDataString(dateKey)}";
        NavigationManager.NavigateTo(targetUrl);
    }

    private void RequestDeleteConfirmation(string dateKey)
    {
        TargetDeleteDateKey = dateKey;
        DisplayDeleteConfirmation = true;
        ExecuteRecordDeletion();
    }

    private void AbortDeleteOperation()
    {
        DisplayDeleteConfirmation = false;
        TargetDeleteDateKey = "";
    }

    private async Task ExecuteRecordDeletion()
    {
        if (string.IsNullOrWhiteSpace(TargetDeleteDateKey))
            return;

        IsDeletionInProgress = true;

        try
        {
            var parsedDate = DateTime.Parse(TargetDeleteDateKey);
            await Db.DeleteAsync(parsedDate);
            await LoadEntries();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting entry: {ex.Message}");
        }
        finally
        {
            IsDeletionInProgress = false;
            DisplayDeleteConfirmation = false;
            TargetDeleteDateKey = "";
        }
    }

}