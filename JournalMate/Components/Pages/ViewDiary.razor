@page "/viewdiary"
@using JournalMaui.Services
@using JournalMaui.Models
@inject JournalDatabase Db
@inject NavigationManager NavigationManager
@inject JournalMate.Services.AppCurrentState AppState
@implements IDisposable

<div class="view-diary-page @(AppState.IsDarkMode ? "dark-theme" : "light-theme")">

    <!-- Page Header -->
    <div class="page-header">
        <h1 class="page-title">Journal Entries</h1>

        <!-- Search Box -->
        <div class="header-controls">
            <div class="search-box">
                <span class="search-icon">🔍</span>
                <input type="search"
                       class="search-input"
                       placeholder="Search entries by title or content..."
                       value="@TitleSearchQuery"
                       @oninput="UpdateSearchFilter" />
            </div>
        </div>
    </div>

    <!-- Entries Table -->
    <div class="table-container">
        @if (IsFetchingData)
        {
            <div class="loading-state">
                <div class="spinner"></div>
                <p>Loading journal entries...</p>
            </div>
        }
        else if (FilteredRecordsList.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">📓</div>
                <h3>No journal entries found</h3>
                <p>Start writing your first entry or try a different search.</p>
            </div>
        }
        else
        {
            <table class="entries-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Title</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in FilteredRecordsList)
                    {
                        <tr class="table-row">
                            <td class="date-cell">
                                @DateTime.Parse(record.DateKey).ToString("MMM dd, yyyy")
                            </td>
                            <td class="title-cell">
                                @record.Title
                            </td>
                            <td class="actions-cell">
                                <button class="action-icon-btn edit-btn"
                                        @onclick="() => NavigateToEditor(record.DateKey)"
                                        title="Edit">
                                    ✏️
                                </button>
                                <button class="action-icon-btn delete-btn"
                                        @onclick="() => RequestDeleteConfirmation(record.DateKey)"
                                        title="Delete">
                                    🗑️
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination -->
            <div class="pagination">
                <span class="page-info">Page 1 of 2</span>
                <div class="page-buttons">
                    <button class="page-btn">&lt;</button>
                    <button class="page-btn active">1</button>
                    <button class="page-btn">2</button>
                    <button class="page-btn">&gt;</button>
                </div>
            </div>
        }
    </div>

</div>

<!-- Delete Confirmation Modal -->
@if (DisplayDeleteConfirmation)
{
    <div class="modal-overlay" @onclick="AbortDeleteOperation">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Delete Entry?</h3>
                <button class="modal-close" @onclick="AbortDeleteOperation">✕</button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the entry for <strong>@(DateTime.Parse(TargetDeleteDateKey).ToString("MMMM dd, yyyy"))</strong>?</p>
                <p class="warning-text">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button class="modal-btn cancel-btn" @onclick="AbortDeleteOperation">Cancel</button>
                <button class="modal-btn delete-btn" @onclick="ExecuteRecordDeletion" disabled="@IsDeletionInProgress">
                    @(IsDeletionInProgress ? "Deleting..." : "Delete")
                </button>
            </div>
        </div>
    </div>
}

