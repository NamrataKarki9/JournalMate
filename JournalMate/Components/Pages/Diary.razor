        font-weight: 600;
        color: #1f2937;
        margin: 0;
    }

    .modal-close {
        background: transparent;
        border: none;
        color: #6b7280;
        font-size: 24px;
        cursor: pointer;
    }

    .modal-body {
        padding: 24px;
    }

        .modal-body p {
            color: #6b7280;
            margin-bottom: 16px;
        }

        .modal-body label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            color: #6b7280;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .modal-input {
        width: 100%;
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 12px;
        color: #1f2937;
        font-size: 14px;
        outline: none;
    }

        .modal-input:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

    .modal-footer {
        padding: 16px 24px;
        border-top: 1px solid #e5e7eb;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .modal-btn {
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        border: none;
        transition: all 0.2s;
    }

    .cancel-btn {
        background: #f3f4f6;
        color: #6b7280;
    }

        .cancel-btn:hover {
            background: #e5e7eb;
        }

    .save-modal-btn {
        background: #667eea;
        color: white;
    }

        .save-modal-btn:hover {
            background: #5a67d8;
        }

    /* Responsive */
    @@media (max-width: 1024px) {
        .diary-container {
            grid-template-columns: 1fr;
        }

        .sidebar-panel {
            border-left: none;
            border-top: 1px solid rgba(255, 255, 255, 0.3);
        }
    }
</style>

@code {
    private DateTime ActiveDate = DateTime.Today;
    private string JournalContent = "";
    private bool IsProcessingRequest = false;
    private string OperationFeedback = "";

    private DateTime? RecordCreationTime;
    private DateTime? RecordModificationTime;

    private string EntryTitle = "";
    private bool DisplayTitlePrompt = false;
    private string ProposedTitle = "";
    private string _selectedMood = "Positive";

    private string FormattedCreationTime => RecordCreationTime?.ToString("yyyy-MM-dd HH:mm") ?? "-";
    private string FormattedUpdateTime => RecordModificationTime?.ToString("yyyy-MM-dd HH:mm") ?? "-";

    protected override async Task OnInitializedAsync()
    {
        await LoadExistingEntry();
    }

    private async Task LoadExistingEntry()
    {
        IsProcessingRequest = true;
        OperationFeedback = "";
        try
        {
            var journalRecord = await Db.GetByDateAsync(ActiveDate);
            if (journalRecord is null)
            {
                JournalContent = "";
                EntryTitle = "";
                RecordCreationTime = null;
                RecordModificationTime = null;
                OperationFeedback = "No entry for this date. Start writing!";
            }
            else
            {
                JournalContent = journalRecord.Content ?? "";
                EntryTitle = journalRecord.Title ?? "";
                RecordCreationTime = journalRecord.CreatedAt;
                RecordModificationTime = journalRecord.UpdatedAt;
                OperationFeedback = "Loaded.";
            }
        }
        finally
        {
            IsProcessingRequest = false;
        }
    }

    private Task InitiateSaveProcess()
    {
        OperationFeedback = "";
        ProposedTitle = string.IsNullOrWhiteSpace(EntryTitle) ? "" : EntryTitle;
        DisplayTitlePrompt = true;
        return Task.CompletedTask;
    }

    private void DismissTitleDialog()
    {
        DisplayTitlePrompt = false;
    }

    private async Task FinalizeEntryWithTitle()
    {
        var sanitizedTitle = (ProposedTitle ?? "").Trim();
        if (string.IsNullOrWhiteSpace(sanitizedTitle))
        {
            OperationFeedback = "Please enter a title.";
            return;
        }

        DisplayTitlePrompt = false;
        await PersistEntryWithTitle(sanitizedTitle);
    }

    private async Task PersistEntryWithTitle(string titleText)
    {
        IsProcessingRequest = true;
        OperationFeedback = "";
        try
        {
            await Db.SaveAsync(ActiveDate, titleText, JournalContent);

            var journalRecord = await Db.GetByDateAsync(ActiveDate);

            EntryTitle = journalRecord?.Title ?? titleText;
            RecordCreationTime = journalRecord?.CreatedAt;
            RecordModificationTime = journalRecord?.UpdatedAt;

            OperationFeedback = "Saved.";
        }
        catch (Exception ex)
        {
            OperationFeedback = $"Save failed: {ex.Message}";
        }
        finally
        {
            IsProcessingRequest = false;
        }
    }

    private async Task RemoveEntry()
    {
        IsProcessingRequest = true;
        OperationFeedback = "";
        try
        {
            await Db.DeleteAsync(ActiveDate);

            JournalContent = "";
            EntryTitle = "";
            RecordCreationTime = null;
            RecordModificationTime = null;

            OperationFeedback = "Deleted.";
        }
        finally
        {
            IsProcessingRequest = false;
        }
    }

    private async Task ProcessTitleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await FinalizeEntryWithTitle();
        }
        else if (e.Key == "Escape")
        {
            DismissTitleDialog();
        }
    }
}