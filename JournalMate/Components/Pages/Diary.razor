        background: rgba(255, 255, 255, 0.95);
        padding: 32px 40px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .date-header {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 14px;
        color: #6b7280;
        margin-bottom: 8px;
    }

    .calendar-icon {
        font-size: 16px;
    }

    .title-input {
        background: transparent;
        border: none;
        outline: none;
        font-size: 24px;
        font-weight: 700;
        color: #1f2937;
        padding: 0;
        margin-bottom: 12px;
    }

        .title-input::placeholder {
            color: #9ca3af;
        }

    .journal-textarea {
        background: transparent;
        border: none;
        outline: none;
        color: #374151;
        font-size: 15px;
        line-height: 1.7;
        resize: none;
        flex: 1;
        min-height: 400px;
        font-family: inherit;
    }

        .journal-textarea::placeholder {
            color: #9ca3af;
        }

    /* Sidebar Panel */
    .sidebar-panel {
        background: rgba(255, 255, 255, 0.9);
        padding: 24px 20px;
        display: flex;
        flex-direction: column;
        gap: 24px;
        border-left: 1px solid rgba(255, 255, 255, 0.3);
        overflow-y: auto;
    }

    .panel-section {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .panel-title {
        font-size: 16px;
        font-weight: 600;
        color: #1f2937;
        margin: 0;
    }

    .section-label {
        font-size: 13px;
        color: #6b7280;
        margin: 8px 0 0 0;
    }

    /* Mood Buttons */
    .mood-buttons {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .mood-btn {
        background: rgba(102, 126, 234, 0.1);
        border: 1px solid rgba(102, 126, 234, 0.2);
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 14px;
        color: #1f2937;
        cursor: pointer;
        transition: all 0.2s;
        text-align: left;
    }

        .mood-btn:hover {
            background: rgba(102, 126, 234, 0.15);
        }

        .mood-btn.active.mood-positive {
            background: rgba(34, 197, 94, 0.2);
            border-color: rgba(34, 197, 94, 0.4);
        }

        .mood-btn.active.mood-neutral {
            background: rgba(59, 130, 246, 0.2);
            border-color: rgba(59, 130, 246, 0.4);
        }

        .mood-btn.active.mood-negative {
