@page "/diary"
@using JournalMaui.Services
@using JournalMaui.Models
@inject JournalDatabase Db

<div class="diary-page">

    <!-- Main Content Area -->
    <div class="diary-container">

        <!-- Journal Editor Section -->
        <div class="editor-section">
            <!-- Date Header -->
            <div class="date-header">
                <span class="calendar-icon">📅</span>
                <span class="date-text">@ActiveDate.ToString("dddd, MMMM dd, yyyy")</span>
            </div>

            <!-- Title Input -->
            <input type="text"
                   class="title-input"
                   placeholder="Morning Reflections on a Quiet Tuesday"
                   @bind="EntryTitle" />

            <!-- Journal Content -->
            <textarea class="journal-textarea"
                      placeholder="Start writing your thoughts..."
                      @bind="JournalContent"></textarea>
        </div>

        <!-- Sidebar Panel -->
        <div class="sidebar-panel">

            <!-- Moods Section -->
            <div class="panel-section">
                <h3 class="panel-title">Moods</h3>
                <div class="mood-buttons">
                    <button class="mood-btn mood-positive @(_selectedMood == "Positive" ? "active" : "")"
                            @onclick='() => _selectedMood = "Positive"'>
                        😊 Positive
                    </button>
                    <button class="mood-btn mood-neutral @(_selectedMood == "Neutral" ? "active" : "")"
                            @onclick='() => _selectedMood = "Neutral"'>
                        😐 Neutral
                    </button>
                    <button class="mood-btn mood-negative @(_selectedMood == "Negative" ? "active" : "")"
                            @onclick='() => _selectedMood = "Negative"'>
                        😞 Negative
                    </button>
                </div>

                <p class="section-label">Secondary Moods:</p>
                <div class="mood-buttons">
                    <button class="mood-btn-small mood-neutral">😐 Neutral</button>
                    <button class="mood-btn-small mood-negative">😞 Negative</button>
                </div>
            </div>

            <!-- Category Section -->
            <div class="panel-section">
                <h3 class="panel-title">Category</h3>
                <select class="category-select">
                    <option>Daily Reflection</option>
                    <option>Work Notes</option>
                    <option>Personal Goals</option>
                    <option>Gratitude</option>
                </select>
            </div>

            <!-- Tags Section -->
            <div class="panel-section">
                <h3 class="panel-title">Tags</h3>
                <div class="tags-container">
                    <span class="tag">Gratitude ×</span>
                    <span class="tag">Mindfulness ×</span>
                    <span class="tag">Productivity ×</span>
                </div>
                <div class="add-tag-row">
                    <input type="text"
                           class="tag-input"
                           placeholder="Add new tag..." />
                    <button class="add-tag-btn">Add</button>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="action-buttons">
                <button class="action-btn save-btn" @onclick="InitiateSaveProcess">
                    💾 Save Entry
                </button>
                <button class="action-btn update-btn">
                    ✏️ Update Entry
                </button>
                <button class="action-btn delete-btn" @onclick="RemoveEntry">
                    🗑️ Delete Entry
                </button>
            </div>

            <!-- Footer -->
            <div class="footer-text">
                © 2025 JournalMate. All rights reserved.
            </div>
        </div>

    </div>
</div>

<!-- Title Modal -->
@if (DisplayTitlePrompt)
{
    <div class="modal-overlay" @onclick="DismissTitleDialog">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">Confirm Save</h3>
                <button class="modal-close" @onclick="DismissTitleDialog">✕</button>
            </div>
            <div class="modal-body">
                <p>
                    Save entry for @ActiveDate.ToString("MMMM dd, yyyy")?
                </p>
                <label>
                    TITLE
                </label>
                <input class="modal-input"
                       @bind="ProposedTitle"
                       placeholder="Enter title..."
                       @onkeydown="ProcessTitleKeyPress" />
            </div>
            <div class="modal-footer">
                <button class="modal-btn cancel-btn" @onclick="DismissTitleDialog">Cancel</button>
                <button class="modal-btn save-modal-btn" @onclick="FinalizeEntryWithTitle">Save</button>
            </div>
        </div>
    </div>
}

<style>
    .diary-page {
        min-height: 100vh;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #1f2937;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .diary-container {
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 0;
        min-height: 100vh;
    }

    /* Editor Section */
