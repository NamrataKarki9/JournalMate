@page "/viewdiary"
@using JournalMaui.Services
@using JournalMaui.Models
@inject JournalDatabase Db
@inject NavigationManager NavigationManager
@inject JournalMate.Services.AppCurrentState AppState
@implements IDisposable

<div class="viewdiary-page">
    <header class="page-header">
        <div class="header-left">
            <h1 class="page-title">📚 Journal Entries</h1>
            <p class="page-subtitle">Your complete journaling history</p>
        </div>
        <div class="header-right">
            <div class="search-box">
                <span class="search-icon">🔍</span>
                <input type="search" class="search-input" placeholder="Search by title or content..."
                       value="@_searchQuery" @oninput="UpdateSearch" />
            </div>
            <select class="filter-select" @bind="_moodFilter" @bind:event="onchange" @bind:after="ApplyFilters">
                <option value="">All Moods</option>
                <option value="Positive">😊 Positive</option>
                <option value="Neutral">😐 Neutral</option>
                <option value="Negative">😔 Negative</option>
            </select>
            <button class="filter-btn @(_showTagFilter ? "active" : "")" @onclick="ToggleTagFilter">
                🏷️ Tags @if (_selectedTags.Any()) {
                <span class="filter-badge">@_selectedTags.Count</span>
                                }
            </button>
        </div>
    </header>

    @if (_showTagFilter)
    {
        <div class="tag-filter-panel glass-card">
            <div class="filter-header">
                <h3>Filter by Tags</h3>
                <button class="clear-btn" @onclick="ClearTagFilters" disabled="@(!_selectedTags.Any())">
                    Clear All
                </button>
            </div>

            @if (_selectedTags.Any())
            {
                <div class="selected-tags">
                    <span class="filter-label">Active Filters:</span>
                    @foreach (var tag in _selectedTags)
                    {
                        <span class="filter-tag">
                            #@tag
                            <button class="remove-filter" @onclick="() => RemoveTagFilter(tag)">×</button>
                        </span>
                    }
                </div>
            }

            <div class="available-tags">
                <span class="filter-label">Available Tags:</span>
                <div class="tag-cloud">
                    @foreach (var tagPair in _availableTags.OrderByDescending(t => t.Value).Take(20))
                    {
                        var isSelected = _selectedTags.Contains(tagPair.Key);
                        <button class="cloud-tag @(isSelected ? "selected" : "")"
                                style="background-color: @TagData.GetTagColor(tagPair.Key);"
                                @onclick="() => ToggleTagFilter(tagPair.Key)">
                            #@tagPair.Key
                            <span class="tag-count">@tagPair.Value</span>
                        </button>
                    }
                </div>
            </div>
        </div>
    }
     
    <div class="table-container glass-card">
        @if (_isLoading)
        {
            <div class="loading-state">
                <div class="spinner"></div>
                <p>Loading entries...</p>
            </div>
        }
        else if (_filteredEntries.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">📝</div>
                <h3>No entries found</h3>
                <p>@(_hasFilters ? "Try adjusting your filters" : "Start writing your first journal entry!")</p>
                @if (!_hasFilters)
                {
                    <button class="start-btn" @onclick='() => NavigationManager.NavigateTo("/diary")'>
                        ✍️ Write Entry
                    </button>
                }
            </div>
        }
        else
        {
            <table class="entries-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Title</th>
                        <th>Mood</th>
                        <th>Words</th>
                        <th>Tags</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in _paginatedEntries)
                    {
                        <tr class="table-row" @onclick="() => NavigateToEntry(entry.DateKey)">
                            <td class="date-cell">
                                @{
                                    DateTime.TryParse(entry.DateKey, out var entryDate);
                                }
                                @entryDate.ToString("MMM dd, yyyy")
                            </td>
                            <td class="title-cell">
                                @entry.Title
                            </td>
                            <td class="mood-cell">
                                @if (!string.IsNullOrEmpty(entry.PrimaryMood))
                                {
                                    <span class="mood-badge"
                                          style="background-color: @(MoodData.GetCategoryColor(entry.MoodCategory) + "20"); color: @MoodData.GetCategoryColor(entry.MoodCategory)">
                                        @MoodData.GetMoodEmoji(entry.PrimaryMood) @entry.PrimaryMood
                                    </span>
                                }
                            </td>
                            <td class="words-cell">
                                @entry.WordCount
                            </td>
                            <td class="tags-cell">
                                @{
                                    var tags = entry.GetTagsList();
                                    var displayTags = tags.Take(2).ToList();
                                    var moreCount = tags.Count - 2;
                                }
                                @foreach (var tag in displayTags)
                                {
                                    var isFiltered = _selectedTags.Contains(tag);
                                    <span class="tag-mini @(isFiltered ? "highlighted" : "")"
                                          style="@(isFiltered ? $"background-color: {TagData.GetTagColor(tag)}30; color: {TagData.GetTagColor(tag)}; border: 1px solid {TagData.GetTagColor(tag)};" : "")">
                                        @tag
                                    </span>
                                }
                                @if (moreCount > 0)
                                {
                                    <span class="tag-more">+@moreCount</span>
                                }
                            </td>
                            <td class="actions-cell" @onclick:stopPropagation="true">
                                <button class="action-icon-btn edit" @onclick="() => NavigateToEntry(entry.DateKey)"
                                        title="Edit">
                                    ✏️
                                </button>
                                <button class="action-icon-btn delete" @onclick="() => ConfirmDelete(entry.Id)" title="Delete">
                                    🗑️
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="pagination">
                <span class="page-info">
                    Showing @((_currentPage - 1) * _pageSize + 1)-@Math.Min(_currentPage * _pageSize,
                                    _filteredEntries.Count) of @_filteredEntries.Count entries
            </span>
            <div class="page-buttons">
                <button class="page-btn" @onclick="FirstPage" disabled="@(_currentPage == 1)">⟪</button>
                <button class="page-btn" @onclick="PreviousPage" disabled="@(_currentPage == 1)">◀</button>
                <span class="current-page">@_currentPage / @_totalPages</span>
                <button class="page-btn" @onclick="NextPage" disabled="@(_currentPage >= _totalPages)">▶</button>
                <button class="page-btn" @onclick="LastPage" disabled="@(_currentPage >= _totalPages)">⟫</button>
            </div>
        </div>
                }
    </div>
</div>

@if (_showDeleteConfirm)
{
    <div class="modal-overlay" @onclick="() => _showDeleteConfirm = false">
        <div class="modal-dialog glass-card" @onclick:stopPropagation="true">
            <h3>Delete Entry?</h3>
            <p>Are you sure you want to delete this entry? This cannot be undone.</p>
            <div class="modal-actions">
                <button class="btn-cancel" @onclick="() => _showDeleteConfirm = false">Cancel</button>
                <button class="btn-delete" @onclick="DeleteEntry">Delete</button>
            </div>
        </div>
    </div>
}

