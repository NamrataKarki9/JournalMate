@code {
    private List<JournalEntry> _allEntries = new();
    private List<JournalEntry> _filteredEntries = new();
    private List<JournalEntry> _paginatedEntries = new();
    private Dictionary<string, int> _availableTags = new();
    private List<string> _selectedTags = new();

    private bool _isLoading = true;
    private string _searchQuery = "";
    private string _moodFilter = "";
    private bool _showTagFilter = false;
    private int _pageSize = 10;
    private int _currentPage = 1;
    private int _totalPages => (int)Math.Ceiling(_filteredEntries.Count / (double)_pageSize);
    private bool _hasFilters => !string.IsNullOrWhiteSpace(_searchQuery) || !string.IsNullOrWhiteSpace(_moodFilter) || _selectedTags.Any();

    private bool _showDeleteConfirm = false;
    private int _deleteTargetId = 0;

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += StateHasChanged;
        AppState.OnDataChanged += HandleDataChanged;
        await LoadEntries();
        await LoadAvailableTags();
    }

    private async void HandleDataChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadEntries();
            await LoadAvailableTags();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
        AppState.OnDataChanged -= HandleDataChanged;
    }

    private async Task LoadEntries()
    {
        Console.WriteLine("[ViewDiary] Loading entries...");
        _isLoading = true;
        try
        {
            _allEntries = await Db.GetAllEntriesAsync();
            Console.WriteLine($"[ViewDiary] Loaded {_allEntries.Count} entries");
            ApplyFilters();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadAvailableTags()
    {
        try
        {
            _availableTags = await Db.GetTagFrequencyAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading tags: {ex.Message}");
        }
    }

    private void UpdateSearch(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? "";
        _currentPage = 1;
        ApplyFilters();
    }

    private void ToggleTagFilter()
    {
        _showTagFilter = !_showTagFilter;
    }

    private void ToggleTagFilter(string tag)
    {
        if (_selectedTags.Contains(tag))
        {
            _selectedTags.Remove(tag);
        }
        else
        {
            _selectedTags.Add(tag);
        }
        _currentPage = 1;
        ApplyFilters();
    }

    private void RemoveTagFilter(string tag)
    {
        _selectedTags.Remove(tag);
        _currentPage = 1;
        ApplyFilters();
    }

    private void ClearTagFilters()
    {
        _selectedTags.Clear();
        _currentPage = 1;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var filtered = _allEntries.AsEnumerable();

        // Search filter
        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            var query = _searchQuery.ToLower();
            filtered = filtered.Where(e =>
                e.Title.ToLower().Contains(query) ||
                e.Content.ToLower().Contains(query));
        }

        // Mood filter
        if (!string.IsNullOrWhiteSpace(_moodFilter))
        {
            filtered = filtered.Where(e => e.MoodCategory == _moodFilter);
        }

        // Tag filter (AND logic - entry must have ALL selected tags)
        if (_selectedTags.Any())
        {
            filtered = filtered.Where(e =>
            {
                var entryTags = e.GetTagsList();
                return _selectedTags.All(selectedTag => entryTags.Contains(selectedTag));
            });
        }

        _filteredEntries = filtered.ToList();
        Console.WriteLine($"[ViewDiary] Filtered entries count: {_filteredEntries.Count}");
        _currentPage = 1;
        UpdatePagination();
    }

    private void UpdatePagination()
    {
        _paginatedEntries = _filteredEntries
            .Skip((_currentPage - 1) * _pageSize)
            .Take(_pageSize)
            .ToList();
    }

    private void GoToPage(int page)
    {
        _currentPage = page;
        UpdatePagination();
    }

    private void FirstPage() => GoToPage(1);
    private void LastPage() => GoToPage(_totalPages);
    private void PreviousPage() { if (_currentPage > 1) GoToPage(_currentPage - 1); }
    private void NextPage() { if (_currentPage < _totalPages) GoToPage(_currentPage + 1); }

    private void NavigateToEntry(string dateKey)
    {
        NavigationManager.NavigateTo($"/diary/{dateKey}");
    }

    private void ConfirmDelete(int id)
    {
        _deleteTargetId = id;
        _showDeleteConfirm = true;
    }

    private async Task DeleteEntry()
    {
        Console.WriteLine($"[ViewDiary] Deleting entry with ID: {_deleteTargetId}");
        if (_deleteTargetId > 0)
        {
            await Db.DeleteByIdAsync(_deleteTargetId);
        }
        _showDeleteConfirm = false;
        await LoadEntries();
        await LoadAvailableTags();
    }
}