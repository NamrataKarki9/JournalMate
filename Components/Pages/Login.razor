@code {
    private string _enteredPin = "";
    private string _confirmPin = "";
    private string _userName = "";
    private string _email = "";
    private string _recoveryEmail = "";
    private string _newResetPin = "";
    private string _confirmResetPin = "";
    private string _loginErrorMessage = "";
    private bool _isAuthenticating = false;
    private bool _isFirstTimeSetup = false;
    private bool _isLockedOut = false;
    private bool _showForgotPinModal = false;
    private bool _showResetPinModal = false;
    private ElementReference _loginPageRef;
    private DateTime? _currentTime;
    private System.Timers.Timer? _timer;
    private double _mouseX = 0;
    private double _mouseY = 0;

    protected override async Task OnInitializedAsync()
    {
        CurrentAppState.OnChange += StateHasChanged;

        try
        {
            _isFirstTimeSetup = !await AuthService.IsPinSetupAsync();

            if (!_isFirstTimeSetup)
            {
                var checkResult = await AuthService.VerifyPinAsync("");
                if (checkResult.message.Contains("locked", StringComparison.OrdinalIgnoreCase))
                {
                    _isLockedOut = true;
                    _loginErrorMessage = checkResult.message;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Login] Error checking setup status: {ex.Message}");
            _isFirstTimeSetup = true;
        }

        _currentTime = DateTime.Now;
        _timer = new System.Timers.Timer(1000);
        _timer.Elapsed += (s, e) =>
        {
            _currentTime = DateTime.Now;
            InvokeAsync(StateHasChanged);
        };
        _timer.Start();
    }

    private void OnNameInput(ChangeEventArgs e)
    {
        var input = e.Value?.ToString() ?? "";
        // Allow only letters and spaces
        if (System.Text.RegularExpressions.Regex.IsMatch(input, @"^[a-zA-Z\s]*$"))
        {
            _userName = input;
        }
        else
        {
             _userName = new string(input.Where(c => char.IsLetter(c) || char.IsWhiteSpace(c)).ToArray());
             ToastFactory.ShowToast("Please enter letters only.", ToastType.Warning);
        }
    }

    private void OnNewPinInput(ChangeEventArgs e)
    {
        var input = e.Value?.ToString() ?? "";
        // Allow only digits and limit to 4 characters
        if (input.All(char.IsDigit) && input.Length <= 4)
        {
            _newResetPin = input;
        }
        else
        {
            _newResetPin = new string(input.Where(char.IsDigit).Take(4).ToArray());
        }
    }

    private void OnConfirmPinInput(ChangeEventArgs e)
    {
        var input = e.Value?.ToString() ?? "";
        // Allow only digits and limit to 4 characters
        if (input.All(char.IsDigit) && input.Length <= 4)
        {
            _confirmResetPin = input;
        }
        else
        {
            _confirmResetPin = new string(input.Where(char.IsDigit).Take(4).ToArray());
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await _loginPageRef.FocusAsync();
            }
            catch { }
        }
    }

    public void Dispose()
    {
        CurrentAppState.OnChange -= StateHasChanged;
        _timer?.Stop();
        _timer?.Dispose();
    }

    private void ToggleTheme()
    {
        CurrentAppState.SwitchThemeMode();
    }

    private void HandleMouseMove(MouseEventArgs e)
    {
        _mouseX = e.ClientX;
        _mouseY = e.ClientY;
    }

    private void AddDigit(string digit)
    {
        if (_isFirstTimeSetup)
        {
            if (_enteredPin.Length < 4) _enteredPin += digit;
            else if (_confirmPin.Length < 4) _confirmPin += digit;
        }
        else
        {
            if (_enteredPin.Length < 4) _enteredPin += digit;
        }
    }

    private void DeleteLastDigit()
    {
        if (_isFirstTimeSetup)
        {
            if (_confirmPin.Length > 0) _confirmPin = _confirmPin[..^1];
            else if (_enteredPin.Length > 0) _enteredPin = _enteredPin[..^1];
        }
        else
        {
            if (_enteredPin.Length > 0) _enteredPin = _enteredPin[..^1];
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (_isAuthenticating || _showForgotPinModal || _showResetPinModal) return;

        if (e.Key.Length == 1 && char.IsDigit(e.Key[0]))
        {
            AddDigit(e.Key);
        }
        else if (e.Key == "Backspace")
        {
            DeleteLastDigit();
        }
        else if (e.Key == "Enter")
        {
            await ProcessLogin();
        }
    }

    private async Task ShowForgotPin()
    {
        _showForgotPinModal = true;
        _recoveryEmail = "";
        await InvokeAsync(StateHasChanged);
    }

    private async Task CloseModals()
    {
        _showForgotPinModal = false;
        _showResetPinModal = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task VerifyRecoveryEmail()
    {
        if (string.IsNullOrWhiteSpace(_recoveryEmail))
        {
            ToastFactory.ShowToast("Please enter your email.", ToastType.Warning);
            return;
        }

        bool verified = await AuthService.VerifyEmailAsync(_recoveryEmail);
        if (verified)
        {
            _showForgotPinModal = false;
            _showResetPinModal = true;
            _newResetPin = "";
            _confirmResetPin = "";
            ToastFactory.ShowToast("Email verified. Please set a new PIN.", ToastType.Success);
        }
        else
        {
            ToastFactory.ShowToast("Email does not match our records.", ToastType.Error);
        }
    }

    private async Task ResetPin()
    {
        if (_newResetPin.Length != 4)
        {
            ToastFactory.ShowToast("PIN must be 4 digits.", ToastType.Warning);
            return;
        }

        if (_newResetPin != _confirmResetPin)
        {
            ToastFactory.ShowToast("PINs do not match.", ToastType.Warning);
            return;
        }

        bool success = await AuthService.OverwritePinAsync(_newResetPin);
        if (success)
        {
            ToastFactory.ShowToast("PIN reset successfully! Please login.", ToastType.Success);
            CloseModals();
            _enteredPin = "";
            _loginErrorMessage = "";
            _isLockedOut = false;
        }
        else
        {
            ToastFactory.ShowToast("Failed to reset PIN.", ToastType.Error);
        }
    }

    private async Task ProcessLogin()
    {
        if (_isFirstTimeSetup)
        {
            if (string.IsNullOrWhiteSpace(_userName) || string.IsNullOrWhiteSpace(_email) || _enteredPin.Length != 4 || _confirmPin.Length != 4) return;
            if (_enteredPin != _confirmPin)
            {
                ToastFactory.ShowToast("PINs do not match. Please try again.", ToastType.Warning);
                _enteredPin = "";
                _confirmPin = "";
                return;
            }

            _isAuthenticating = true;
            bool success = await AuthService.SetupPinAsync(_enteredPin, _userName, _email);
            if (success)
            {
                ToastFactory.ShowToast("Setup complete! Welcome to JournalMate.", ToastType.Success);
                CurrentAppState.AuthenticateUser(_userName);
                NavManager.NavigateTo("/dashboard", replace: true);
            }
            else
            {
               ToastFactory.ShowToast("Setup failed. Please try again.", ToastType.Error);
            }
            _isAuthenticating = false;
        }
        else
        {
            if (_enteredPin.Length != 4) return;

            _isAuthenticating = true;
            _loginErrorMessage = "";

            var result = await AuthService.VerifyPinAsync(_enteredPin);
            if (result.success)
            {
                ToastFactory.ShowToast($"Welcome back, {result.displayName}!", ToastType.Success);
                CurrentAppState.AuthenticateUser(result.displayName);
                NavManager.NavigateTo("/dashboard", replace: true);
            }
            else
            {
                _enteredPin = "";
                _loginErrorMessage = result.message;
                _isLockedOut = result.message.Contains("locked", StringComparison.OrdinalIgnoreCase);
                if (_isLockedOut)
                {
                    ToastFactory.ShowToast("Account locked due to too many failed attempts.", ToastType.Error);
                }
                else
                {
                    ToastFactory.ShowToast("Incorrect PIN. Please try again.", ToastType.Error);
                }
            }
            _isAuthenticating = false;
        }
    }
}