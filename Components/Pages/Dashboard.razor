@code {
    private int _totalEntries = 0;
    private int _totalWords = 0;
    private int _entriesThisWeek = 0;
    private int _entriesThisMonth = 0;
    private int _currentStreak = 0;
    private int _longestStreak = 0;
    private int _journalingDays = 0;
    private int _averageWords = 0;
    private string _mostFrequentMood = "";
    private int _mostFrequentMoodCount = 0;
    private int _positivePercentage = 0;
    private int _neutralPercentage = 0;
    private int _negativePercentage = 0;
    private Dictionary<string, int> _topTags = new();
    private List<JournalEntry> _recentEntries = new();
    private List<DateTime> _missedDays = new();
    private List<WeeklyActivityData> _weeklyActivity = new();
    private string SelectedMood = "";
    private int _selectedRange = 30;

    // For ring chart calculations
    private double _circumference = 2 * Math.PI * 70; // radius = 70

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += StateHasChanged;
        AppState.OnDataChanged += HandleDataChanged;
        await LoadDashboardData();
    }

    private async void HandleDataChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadDashboardData();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
        AppState.OnDataChanged -= HandleDataChanged;
    }

    private async Task LoadDashboardData()
    {
        try
        {
            // Calculate date range
            var endDate = DateTime.Today;
            var startDate = _selectedRange == 0 ? DateTime.MinValue : endDate.AddDays(-_selectedRange);

            // Get all entries for the selected range
            var allEntries = _selectedRange == 0
                ? await Db.GetAllEntriesAsync()
                : await Db.GetEntriesByDateRangeAsync(startDate, endDate);

            _totalEntries = allEntries.Count;
            _totalWords = allEntries.Sum(e => e.WordCount);
            _averageWords = _totalEntries > 0 ? _totalWords / _totalEntries : 0;

            // Streak calculations
            _currentStreak = await Db.GetCurrentStreakAsync();
            _longestStreak = await Db.GetLongestStreakAsync();

            // Mood distribution
            var moodDist = await Db.GetMoodDistributionAsync();
            var totalMoodEntries = moodDist.Values.Sum();
            if (totalMoodEntries > 0)
            {
                _positivePercentage = (int)((moodDist.GetValueOrDefault("Positive", 0) * 100.0) / totalMoodEntries);
                _neutralPercentage = (int)((moodDist.GetValueOrDefault("Neutral", 0) * 100.0) / totalMoodEntries);
                _negativePercentage = (int)((moodDist.GetValueOrDefault("Negative", 0) * 100.0) / totalMoodEntries);
            }

            // Most frequent mood
            _mostFrequentMood = await Db.GetMostFrequentMoodAsync();
            _mostFrequentMoodCount = allEntries.Count(e => e.PrimaryMood == _mostFrequentMood);

            // Tags
            _topTags = await Db.GetTagFrequencyAsync();
            _recentEntries = await Db.GetRecentAsync(3);

            // Missed days (last 30 days only)
            _missedDays = await Db.GetMissedDaysAsync(30);

            // Week and month counts
            _entriesThisWeek = await Db.GetEntriesThisWeekAsync();
            _entriesThisMonth = await Db.GetEntriesThisMonthAsync();

            // Calculate journaling days
            var allDates = await Db.GetAllEntryDatesAsync();
            if (allDates.Any() && DateTime.TryParse(allDates.Min(), out var firstDate))
            {
                _journalingDays = (int)(DateTime.Today - firstDate).TotalDays + 1;
            }

            // Load weekly activity data
            await LoadWeeklyActivity();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard: {ex.Message}");
        }
    }

    private async Task LoadWeeklyActivity()
    {
        _weeklyActivity = new List<WeeklyActivityData>();
        var today = DateTime.Today;

        for (int i = 6; i >= 0; i--)
        {
            var date = today.AddDays(-i);
            var entry = await Db.GetByDateAsync(date);
            _weeklyActivity.Add(new WeeklyActivityData
            {
                DayName = date.ToString("ddd"),
                Count = entry != null ? 1 : 0,
                Date = date
            });
        }
    }

    private string GetActivityBarColor(int count)
    {
        if (count == 0) return "linear-gradient(180deg, rgba(147, 51, 234, 0.2) 0%, rgba(118, 75, 162, 0.2) 100%)";
        return "linear-gradient(180deg, #667eea 0%, #764ba2 100%)";
    }

    // Ring chart helper methods
    private double GetCircumference() => _circumference;

    private double GetPositiveOffset()
    {
        return _circumference;
    }

    private double GetNeutralOffset()
    {
        var positiveArc = (_positivePercentage / 100.0) * _circumference;
        return _circumference - positiveArc;
    }

    private double GetNegativeOffset()
    {
        var positiveArc = (_positivePercentage / 100.0) * _circumference;
        var neutralArc = (_neutralPercentage / 100.0) * _circumference;
        return _circumference - positiveArc - neutralArc;
    }

    private string GetGreeting()
    {
        var hour = DateTime.Now.Hour;
        if (hour < 12) return "Good morning";
        if (hour < 17) return "Good afternoon";
        return "Good evening";
    }

    private string GetStreakMessage()
    {
        if (_currentStreak == 0) return "Start your streak by writing today!";
        if (_currentStreak == 1) return "Great start! Keep the momentum going.";
        if (_currentStreak < 7) return "You're building a great habit!";
        if (_currentStreak < 30) return "Your mental garden is thriving. You've bloomed every day this week.";
        return "Amazing dedication! You're a journaling master.";
    }

    private void SelectAndNavigate(string mood)
    {
        SelectedMood = mood;
        AppState.SetGlobalMood(mood);
        NavManager.NavigateTo($"/diary?mood={mood}");
    }

    private string FormatRelativeDate(string dateKey)
    {
        if (!DateTime.TryParse(dateKey, out var date)) return dateKey;

        var today = DateTime.Today;
        var diff = (today - date.Date).Days;

        if (diff == 0) return "Today";
        if (diff == 1) return "Yesterday";
        if (diff < 7) return date.ToString("dddd");
        return date.ToString("MMM d");
    }

    private string TruncateText(string text, int maxLength)
    {
        if (string.IsNullOrEmpty(text)) return "";
        return text.Length <= maxLength ? text : text.Substring(0, maxLength) + "...";
    }

    private class WeeklyActivityData
    {
        public string DayName { get; set; } = "";
        public int Count { get; set; }
        public DateTime Date { get; set; }
    }
}