@page "/dashboard"
@using JournalMaui.Services
@using JournalMaui.Models
@using JournalMate.Services
@inject JournalDatabase Db
@inject NavigationManager NavManager
@inject AppCurrentState AppState
@implements IDisposable

<div class="dashboard-page">
    <header class="page-header">
        <div class="greeting-section">
            <h1 class="greeting">@GetGreeting(), @AppState.UserDisplayName!</h1>
            <p class="subtitle">Your garden is thriving. Take a moment to reflect today.</p>
        </div>
        <div class="header-actions">
            <button class="theme-toggle-btn" @onclick="() => AppState.SwitchThemeMode()" title="Toggle Theme">
                @(AppState.IsDarkMode ? "☀️" : "🌙")
            </button>
            <div class="date-badge">
                <span class="date-icon">📅</span>
                <span>@DateTime.Now.ToString("dddd, MMM d")</span>
            </div>
        </div>
    </header>

    <div class="dashboard-grid">
        <div class="main-column">
            <!-- Mood Selection Card -->
            <div class="glass-card mood-card">
                <h2 class="card-title">
                    <span>😊</span> How are you feeling today?
                </h2>
                <div class="mood-grid">
                    @foreach (var mood in MoodData.GetAllMoods())
                    {
                        <button class="mood-chip @(SelectedMood == mood ? "active" : "")"
                                @onclick="() => SelectAndNavigate(mood)">
                            <span class="emoji">@MoodData.GetMoodEmoji(mood)</span>
                            <span class="label">@mood</span>
                        </button>
                    }
                </div>
            </div>

            <!-- Analytics Section -->
            <div class="analytics-section">
                <div class="section-header">
                    <h2 class="section-title">📊 Your Analytics</h2>
                    <div class="date-filter">
                        <select class="filter-select" @bind="_selectedRange" @bind:after="LoadDashboardData">
                            <option value="7">Last 7 Days</option>
                            <option value="30">Last 30 Days</option>
                            <option value="90">Last 3 Months</option>
                            <option value="365">Last Year</option>
                            <option value="0">All Time</option>
                        </select>
                    </div>
                </div>

                <!-- Stats Overview Grid -->
                <div class="stats-overview-grid">
                    <div class="stat-card glass-card">
                        <div class="stat-icon" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">📝</div>
                        <div class="stat-content">
                            <span class="stat-value">@_totalEntries</span>
                            <span class="stat-label">Total Entries</span>
                        </div>
                    </div>
                    <div class="stat-card glass-card">
                        <div class="stat-icon" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">✍️</div>
                        <div class="stat-content">
                            <span class="stat-value">@_totalWords</span>
                            <span class="stat-label">Total Words</span>
                        </div>
                    </div>
                    <div class="stat-card glass-card">
                        <div class="stat-icon" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">🔥</div>
                        <div class="stat-content">
                            <span class="stat-value">@_currentStreak</span>
                            <span class="stat-label">Current Streak</span>
                        </div>
                    </div>
                    <div class="stat-card glass-card">
                        <div class="stat-icon" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">🏆</div>
                        <div class="stat-content">
                            <span class="stat-value">@_longestStreak</span>
                            <span class="stat-label">Longest Streak</span>
                        </div>
                    </div>
                    <div class="stat-card glass-card">
                        <div class="stat-icon" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);">📈</div>
                        <div class="stat-content">
                            <span class="stat-value">@_averageWords</span>
                            <span class="stat-label">Avg Words/Entry</span>
                        </div>
                    </div>
                    <div class="stat-card glass-card">
                        <div class="stat-icon" style="background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);">📅</div>
                        <div class="stat-content">
                            <span class="stat-value">@_journalingDays</span>
                            <span class="stat-label">Days Journaling</span>
                        </div>
                    </div>
                </div>

                <!-- Visual Charts Row -->
                <div class="visual-charts-row">
                    <!-- Weekly Activity Chart -->
                    <div class="glass-card weekly-activity-card">
                        <div class="chart-header">
                            <h3 class="card-subtitle">📈 Weekly Activity</h3>
                            <span class="time-label">Last 7 Days</span>
                        </div>
                        <div class="weekly-chart">
                            @{
                                var maxEntries = _weeklyActivity.Any() ? _weeklyActivity.Max(x => x.Count) : 1;
                            }
                            <div class="chart-bars">
                                @foreach (var day in _weeklyActivity)
                                {
                                    var heightPercentage = maxEntries > 0 ? (day.Count * 100.0 / maxEntries) : 0;
                                    var barColor = GetActivityBarColor(day.Count);
                                    <div class="bar-column">
                                        <div class="bar-wrapper">
                                            <div class="bar-fill" style="height: @heightPercentage%; background: @barColor;">
                                                <span class="bar-value">@day.Count</span>
                                            </div>
                                        </div>
                                        <span class="bar-day-label">@day.DayName</span>
                                    </div>
                                }
                            </div>
                            <div class="chart-stats">
                                <div class="chart-stat-item">
                                    <span class="stat-dot" style="background: #667eea;"></span>
                                    <span>@_weeklyActivity.Sum(x => x.Count) entries this week</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Mood Completion Ring -->
                    <div class="glass-card completion-ring-card">
                        <h3 class="card-subtitle">🎯 Mood Tracking</h3>
                        <div class="ring-container">
                            <svg class="progress-ring" width="200" height="200" viewBox="0 0 200 200">
                                <defs>
                                    <linearGradient id="positiveGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" style="stop-color:#22c55e;stop-opacity:1" />
                                        <stop offset="100%" style="stop-color:#16a34a;stop-opacity:1" />
                                    </linearGradient>
                                    <linearGradient id="neutralGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" style="stop-color:#f59e0b;stop-opacity:1" />
                                        <stop offset="100%" style="stop-color:#d97706;stop-opacity:1" />
                                    </linearGradient>
                                    <linearGradient id="negativeGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" style="stop-color:#ef4444;stop-opacity:1" />
                                        <stop offset="100%" style="stop-color:#dc2626;stop-opacity:1" />
                                    </linearGradient>
                                </defs>
                                <!-- Background Circle -->
                                <circle cx="100" cy="100" r="70" fill="none" stroke="var(--jm-surface)" stroke-width="12"></circle>

                                <!-- Positive Mood Arc -->
                                <circle cx="100" cy="100" r="70" fill="none"
                                        stroke="url(#positiveGradient)"
                                        stroke-width="12"
                                        stroke-dasharray="@GetCircumference()"
                                        stroke-dashoffset="@GetPositiveOffset()"
                                        transform="rotate(-90 100 100)"
                                        stroke-linecap="round"></circle>

                                <!-- Neutral Mood Arc -->
                                <circle cx="100" cy="100" r="70" fill="none"
                                        stroke="url(#neutralGradient)"
                                        stroke-width="12"
                                        stroke-dasharray="@GetCircumference()"
                                        stroke-dashoffset="@GetNeutralOffset()"
                                        transform="rotate(-90 100 100)"
                                        stroke-linecap="round"></circle>

                                <!-- Negative Mood Arc -->
                                <circle cx="100" cy="100" r="70" fill="none"
                                        stroke="url(#negativeGradient)"
                                        stroke-width="12"
                                        stroke-dasharray="@GetCircumference()"
                                        stroke-dashoffset="@GetNegativeOffset()"
                                        transform="rotate(-90 100 100)"
                                        stroke-linecap="round"></circle>
                            </svg>
                            <div class="ring-center-text">
                                <div class="center-percentage">@_totalEntries</div>
                                <div class="center-label">Total<br />Entries</div>
                            </div>
                        </div>
                        <div class="ring-legend">
                            <div class="legend-item">
                                <span class="legend-dot positive"></span>
                                <span class="legend-label">Positive</span>
                                <span class="legend-value">@_positivePercentage%</span>
                            </div>
                            <div class="legend-item">
                                <span class="legend-dot neutral"></span>
                                <span class="legend-label">Neutral</span>
                                <span class="legend-value">@_neutralPercentage%</span>
                            </div>
                            <div class="legend-item">
                                <span class="legend-dot negative"></span>
                                <span class="legend-label">Negative</span>
                                <span class="legend-value">@_negativePercentage%</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Mood Distribution & Most Frequent Mood -->
                <div class="analytics-row">
                    <div class="glass-card mood-distribution-card">
                        <h3 class="card-subtitle">😊 Mood Distribution</h3>
                        <div class="mood-chart">
                            @if (_totalEntries > 0)
                            {
                                <div class="mood-bars">
                                    <div class="mood-bar-item">
                                        <div class="bar-info">
                                            <span class="bar-label">😊 Positive</span>
                                            <span class="bar-percentage">@_positivePercentage%</span>
                                        </div>
                                        <div class="bar-container">
                                            <div class="bar positive" style="width: @_positivePercentage%"></div>
                                        </div>
                                    </div>
                                    <div class="mood-bar-item">
                                        <div class="bar-info">
                                            <span class="bar-label">😐 Neutral</span>
                                            <span class="bar-percentage">@_neutralPercentage%</span>
                                        </div>
                                        <div class="bar-container">
                                            <div class="bar neutral" style="width: @_neutralPercentage%"></div>
                                        </div>
                                    </div>
                                    <div class="mood-bar-item">
                                        <div class="bar-info">
                                            <span class="bar-label">😔 Negative</span>
                                            <span class="bar-percentage">@_negativePercentage%</span>
                                        </div>
                                        <div class="bar-container">
                                            <div class="bar negative" style="width: @_negativePercentage%"></div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <p class="empty-state-text">Start journaling to see your mood patterns!</p>
                            }
                        </div>
                    </div>

                    <div class="glass-card most-frequent-card">
                        <h3 class="card-subtitle">🎯 Most Frequent Mood</h3>
                        @if (!string.IsNullOrEmpty(_mostFrequentMood))
                        {
                            <div class="frequent-mood-display">
                                <div class="mood-emoji-large">@MoodData.GetMoodEmoji(_mostFrequentMood)</div>
                                <div class="mood-name">@_mostFrequentMood</div>
                                <div class="mood-count">@_mostFrequentMoodCount times</div>
                            </div>
                        }
                        else
                        {
                            <p class="empty-state-text">No mood data yet</p>
                        }
                    </div>
                </div>

                <!-- Tags Analytics -->
                <div class="glass-card tags-analytics-card">
                    <h3 class="card-subtitle">🏷️ Most Used Tags</h3>
                    @if (_topTags.Any())
                    {
                        <div class="tags-chart">
                            @foreach (var tag in _topTags.Take(8))
                            {
                                var percentage = _totalEntries > 0 ? (tag.Value * 100.0 / _totalEntries) : 0;
                                <div class="tag-bar-item">
                                    <div class="tag-info">
                                        <span class="tag-name">#@tag.Key</span>
                                        <span class="tag-count">@tag.Value entries (@percentage.ToString("F0")%)</span>
                                    </div>
                                    <div class="tag-bar-container">
                                        <div class="tag-bar" style="width: @percentage%; background: @TagData.GetTagColor(tag.Key);"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="empty-state-text">Add tags to your entries to see insights!</p>
                    }
                </div>

                <!-- Missed Days -->
                @if (_missedDays.Any())
                {
                    <div class="glass-card missed-days-card">
                        <h3 class="card-subtitle">📅 Recent Missed Days</h3>
                        <div class="missed-days-list">
                            @foreach (var day in _missedDays.Take(7))
                            {
                                <div class="missed-day-chip">
                                    @day.ToString("MMM d, yyyy")
                                </div>
                            }
                        </div>
                        @if (_missedDays.Count > 7)
                        {
                            <p class="missed-count-text">+@(_missedDays.Count - 7) more missed days in the last 30 days</p>
                        }
                    </div>
                }
            </div>

            <!-- Recent Reflections -->
            <div class="reflections-section">
                <div class="section-header">
                    <h2 class="section-title">Recent Reflections</h2>
                    <button class="view-all-btn" @onclick='() => NavManager.NavigateTo("/viewdiary")'>
                        View All
                    </button>
                </div>
                <div class="reflections-grid">
                    @if (_recentEntries.Any())
                    {
                        @foreach (var entry in _recentEntries.Take(3))
                        {
                            <div class="reflection-card glass-card"
                                 @onclick='() => NavManager.NavigateTo($"/diary/{entry.DateKey}")'>
                                <div class="reflection-header">
                                    <span class="reflection-date">@FormatRelativeDate(entry.DateKey)</span>
                                    <span class="reflection-mood" style="color: @MoodData.GetCategoryColor(entry.MoodCategory)">
                                        @MoodData.GetMoodEmoji(entry.PrimaryMood)
                                    </span>
                                </div>
                                <p class="reflection-content">
                                    "@TruncateText(entry.Content, 80)"
                                </p>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            <p>No entries yet. Start your journaling journey today!</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="side-column">
            <!-- Streak Card -->
            <div class="glass-card streak-card">
                <span class="streak-label">DAILY BLOOM</span>
                <div class="streak-icon">🌸</div>
                <div class="streak-value">@_currentStreak Day Streak!</div>
                <p class="streak-message">
                    @GetStreakMessage()
                </p>
                <button class="streak-btn" @onclick='() => NavManager.NavigateTo("/calendar")'>
                    View Growth Timeline
                </button>
            </div>

            <!-- Weekly Insights -->
            <div class="glass-card insights-card">
                <span class="insights-label">WEEKLY INSIGHTS</span>

                <div class="insight-item">
                    <span class="insight-icon" style="background: var(--jm-accent);">😊</span>
                    <div class="insight-content">
                        <span class="insight-title">Dominant Mood</span>
                        <span class="insight-value">@(string.IsNullOrEmpty(_mostFrequentMood) ? "Not enough data" : _mostFrequentMood)</span>
                    </div>
                </div>

                <div class="insight-item">
                    <span class="insight-icon" style="background: var(--jm-accent-dark);">#</span>
                    <div class="insight-content">
                        <span class="insight-title">Key Themes</span>
                        <div class="theme-tags">
                            @foreach (var tag in _topTags.Take(3))
                            {
                                <span class="theme-tag">@tag.Key</span>
                            }
                        </div>
                    </div>
                </div>

                @if (_totalEntries > 5)
                {
                    <div class="insight-suggestion">
                        <p>"You seem to feel most peaceful when writing about @(_topTags.FirstOrDefault().Key ?? "personal growth"). Keep exploring this theme!"</p>
                    </div>
                }
            </div>

            <!-- Mini Stats -->
            <div class="stats-row">
                <div class="stat-mini glass-card">
                    <span class="stat-value">@_entriesThisWeek</span>
                    <span class="stat-label">This Week</span>
                </div>
                <div class="stat-mini glass-card">
                    <span class="stat-value">@_entriesThisMonth</span>
                    <span class="stat-label">This Month</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .dashboard-page {
        min-height: 100vh;
        padding: 32px 40px;
        background: var(--jm-bg-primary);
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 32px;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .theme-toggle-btn {
        width: 40px;
        height: 40px;
        background: var(--jm-surface);
        border: 1px solid var(--jm-border);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        cursor: pointer;
        transition: all var(--jm-transition-fast);
    }

        .theme-toggle-btn:hover {
            background: var(--jm-surface-hover);
            border-color: var(--jm-accent);
            transform: rotate(180deg);
        }

    .greeting {
        font-size: 32px;
        font-weight: 700;
        color: var(--jm-text-primary);
        margin: 0 0 8px 0;
    }

    .subtitle {
        font-size: 16px;
        color: var(--jm-text-secondary);
        margin: 0;
    }

    .date-badge {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        background: var(--jm-surface);
        border: 1px solid var(--jm-border);
        border-radius: var(--jm-radius-full);
        color: var(--jm-text-secondary);
        font-size: 14px;
    }

    .dashboard-grid {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 24px;
    }

    .main-column {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .side-column {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    /* Mood Card */
    .mood-card {
        padding: 24px;
    }

    .card-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 18px;
        font-weight: 600;
        color: var(--jm-text-primary);
        margin: 0 0 20px 0;
    }

    .mood-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 10px;
    }

    .mood-chip {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 16px 8px;
        background: var(--jm-surface);
        border: 1px solid var(--jm-border);
        border-radius: var(--jm-radius-md);
        cursor: pointer;
        transition: all var(--jm-transition-fast);
    }

        .mood-chip:hover {
            background: var(--jm-surface-hover);
            border-color: var(--jm-accent);
            transform: translateY(-2px);
        }

        .mood-chip.active {
            background: rgba(147, 51, 234, 0.2);
            border-color: var(--jm-accent);
            box-shadow: var(--jm-shadow-glow);
        }

        .mood-chip .emoji {
            font-size: 24px;
        }

        .mood-chip .label {
            font-size: 11px;
            color: var(--jm-text-secondary);
            font-weight: 500;
        }

        .mood-chip.active .label {
            color: var(--jm-accent-light);
        }

    /* Analytics Section */
    .analytics-section {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .section-title {
        font-size: 18px;
        font-weight: 600;
        color: var(--jm-text-primary);
        margin: 0;
    }

    .date-filter {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .filter-select {
        padding: 8px 16px;
        background: var(--jm-surface);
        border: 1px solid var(--jm-border);
        border-radius: var(--jm-radius-md);
        color: var(--jm-text-primary);
        font-size: 13px;
        cursor: pointer;
        outline: none;
        transition: all var(--jm-transition-fast);
    }

        .filter-select:hover {
            border-color: var(--jm-accent);
        }

    /* Stats Overview Grid */
    .stats-overview-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }

    .stat-card {
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 16px;
        transition: all var(--jm-transition-fast);
    }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--jm-shadow-md);
        }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: var(--jm-radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        flex-shrink: 0;
    }

    .stat-content {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .stat-value {
        font-size: 24px;
        font-weight: 700;
        color: var(--jm-text-primary);
    }

    .stat-label {
        font-size: 11px;
        text-transform: uppercase;
        color: var(--jm-text-muted);
        letter-spacing: 0.5px;
    }

    /* Visual Charts Row */
    .visual-charts-row {
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 16px;
    }

    /* Weekly Activity Chart */
    .weekly-activity-card {
        padding: 24px;
    }

    .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .time-label {
        font-size: 12px;
        color: var(--jm-text-muted);
        background: var(--jm-surface);
        padding: 6px 12px;
        border-radius: var(--jm-radius-full);
    }

    .weekly-chart {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .chart-bars {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 12px;
        height: 180px;
    }

    .bar-column {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
    }

    .bar-wrapper {
        width: 100%;
        height: 160px;
        display: flex;
        align-items: flex-end;
        justify-content: center;
    }

    .bar-fill {
        width: 100%;
        max-width: 40px;
        background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
        border-radius: var(--jm-radius-sm) var(--jm-radius-sm) 0 0;
        position: relative;
        transition: height 0.6s ease;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding-top: 8px;
    }

    .bar-value {
        font-size: 11px;
        font-weight: 700;
        color: white;
    }

    .bar-day-label {
        font-size: 11px;
        color: var(--jm-text-muted);
        font-weight: 600;
        text-transform: uppercase;
    }

    .chart-stats {
        display: flex;
        gap: 16px;
        padding-top: 12px;
        border-top: 1px solid var(--jm-border);
    }

    .chart-stat-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: var(--jm-text-secondary);
    }

    .stat-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    /* Completion Ring Chart */
    .completion-ring-card {
        padding: 24px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .ring-container {
        position: relative;
