</style>

@code {
    private DateTime _currentMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime _firstDayOfMonth => new DateTime(_currentMonth.Year, _currentMonth.Month, 1);
    private int _daysInMonth => DateTime.DaysInMonth(_currentMonth.Year, _currentMonth.Month);

    private List<JournalEntry> _entries = new();
    private JournalEntry? _selectedEntry = null;
    private bool _isListView = false;

    private void ToggleView(bool isList)
    {
        _isListView = isList;
    }

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += StateHasChanged;
        AppState.OnDataChanged += HandleDataChanged;
        try
        {
            await LoadCalendarData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error initializing calendar: {ex.Message}");
        }
    }

    private async void HandleDataChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadCalendarData();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
        AppState.OnDataChanged -= HandleDataChanged;
    }

    private async Task LoadCalendarData()
    {
        try
        {
            var startDate = _firstDayOfMonth;
            var endDate = new DateTime(_currentMonth.Year, _currentMonth.Month, _daysInMonth);
            _entries = await Db.GetEntriesByDateRangeAsync(startDate, endDate);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading calendar data: {ex.Message}");
            _entries = new List<JournalEntry>();
        }
    }

    private async Task PreviousMonth()
    {
        _currentMonth = _currentMonth.AddMonths(-1);
        await LoadCalendarData();
    }

    private async Task NextMonth()
    {
        if (_currentMonth.Year < DateTime.Today.Year ||
        (_currentMonth.Year == DateTime.Today.Year && _currentMonth.Month < DateTime.Today.Month))
        {
            _currentMonth = _currentMonth.AddMonths(1);
            await LoadCalendarData();
        }
    }

    private void SelectDay(JournalEntry? entry, DateTime date)
    {
        if (date > DateTime.Today) return;

        if (entry != null)
        {
            _selectedEntry = entry;
        }
        else
        {
            NavManager.NavigateTo($"/diary/{date:yyyy-MM-dd}");
        }
    }

    private void ClosePreview()
    {
        _selectedEntry = null;
    }

    private void EditSelectedEntry()
    {
        if (_selectedEntry != null)
        {
            NavManager.NavigateTo($"/diary/{_selectedEntry.DateKey}");
        }
    }

    private string GetMoodColor(string category) => category switch
    {
        "Positive" => "#22c55e",
        "Neutral" => "#3b82f6",
        "Negative" => "#ef4444",
        _ => "#9333ea"
    };

    private string GetMoodIcon(string mood)
    {
        return mood?.ToLower() switch
        {
            "happy" or "excited" or "ecstatic" => "✨",
            "relaxed" or "calm" or "peaceful" => "🌿",
            "grateful" or "inspired" => "💜",
            "thoughtful" or "reflective" or "curious" => "☁️",
            "stressed" or "anxious" => "⚡",
            "sad" or "lonely" => "🌧️",
            "productive" => "🔥",
            _ => "🌸"
        };
    }


}