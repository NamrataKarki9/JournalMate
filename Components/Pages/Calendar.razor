@page "/calendar"
@using JournalMate.Services
@using JournalMaui.Models
@inject JournalDatabase Db
@inject NavigationManager NavManager
@inject JournalMate.Services.AppCurrentState AppState
@implements IDisposable

<div class="calendar-page">
    <header class="page-header">
        <div class="header-left">
            <h1 class="page-title">Journal History</h1>
            <p class="page-subtitle">Visualizing your growth</p>
        </div>
        <div class="header-right">
            <div class="search-box">
                <span class="search-icon">🔍</span>
                <input type="text" placeholder="Search entries..." class="search-input" />
            </div>
        </div>
    </header>

    <div class="calendar-layout">
        <main class="calendar-main">
            <div class="month-header">
                <button class="month-nav-btn" @onclick="PreviousMonth">◀</button>
                <h2 class="month-title">@_currentMonth.ToString("MMMM yyyy")</h2>
                <button class="month-nav-btn" @onclick="NextMonth"
                    disabled="@(_currentMonth.Year >= DateTime.Today.Year && _currentMonth.Month >= DateTime.Today.Month)">
                    ▶
                </button>
                <div class="view-toggle">
                    <button class="toggle-btn @(!_isListView ? "active" : "")" @onclick="() => ToggleView(false)">Grid
                        View</button>
                    <button class="toggle-btn @(_isListView ? "active" : "")" @onclick="() => ToggleView(true)">List
                        View</button>
                </div>
            </div>

            <div class="breadcrumb">
                <span>History</span>
                <span class="separator">›</span>
                <span class="current">@_currentMonth.ToString("MMMM yyyy")</span>
            </div>

            @if (!_isListView)
            {
                <div class="calendar-grid glass-card">
                    <div class="weekday-row">
                        @foreach (var day in new[] { "SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT" })
                        {
                            <div class="weekday">@day</div>
                        }
                    </div>

                    <div class="days-grid">
                        @for (int i = 0; i < (int)_firstDayOfMonth.DayOfWeek; i++)
                        {
                            <div class="day-cell empty"></div>
                        }
                        @for (int day = 1; day <= _daysInMonth; day++)
                        {
                            var currentDay = day;
                            var date = new DateTime(_currentMonth.Year, _currentMonth.Month, currentDay);
                            var dateKey = date.ToString("yyyy-MM-dd");
                            var entry = _entries.FirstOrDefault(e => e.DateKey == dateKey);
                            var hasEntry = entry != null;
                            var isToday = date.Date == DateTime.Today;
                            var isFuture = date.Date > DateTime.Today;
                            var isSelected = _selectedEntry?.DateKey == dateKey;

                            <div class="day-cell @(hasEntry ? "has-entry" : "") @(isToday ? "today" : "") @(isFuture ? "future" : "") @(isSelected ? "selected" : "")"
                                @onclick="() => SelectDay(entry, date)">
                                <span class="day-number">@currentDay</span>
                                @if (hasEntry)
                                {
                                    <span class="entry-icon" style="color: @GetMoodColor(entry!.MoodCategory)">
                                        @GetMoodIcon(entry.PrimaryMood)
                                    </span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="entries-list-view glass-card">
                    @if (!_entries.Any())
                    {
                        <div class="no-entries-msg">
                            <span class="msg-icon">📭</span>
                            <p>No entries found for this month.</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-container">
                            @foreach (var entry in _entries.OrderByDescending(e => e.DateKey))
                            {
                                DateTime.TryParse(entry.DateKey, out var date);
                                <div class="list-item @(_selectedEntry?.Id == entry.Id ? "selected" : "")"
                                    @onclick="() => SelectDay(entry, date)">
                                    <div class="item-date-box">
                                        <span class="item-day">@date.ToString("dd")</span>
                                        <span class="item-month">@date.ToString("MMM")</span>
                                    </div>
                                    <div class="item-content">
                                        <div class="item-header">
                                            <h4 class="item-title">@(string.IsNullOrEmpty(entry.Title) ? "Untitled" : entry.Title)
                                            </h4>
                                            <span class="item-mood" style="color: @GetMoodColor(entry.MoodCategory)">
                                                @GetMoodIcon(entry.PrimaryMood) @entry.PrimaryMood
                                            </span>
                                        </div>
                                        <p class="item-snippet">@entry.GetPlainTextSnippet(120)</p>
                                        <div class="item-footer">
                                            <span class="item-time">@entry.CreatedAt.ToString("h:mm tt")</span>
                                            @if (entry.GetTagsList().Any())
                                            {
                                                <div class="item-tags">
                                                    @foreach (var tag in entry.GetTagsList().Take(2))
                                                    {
                                                        <span class="item-tag">#@tag</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </main>

        <aside class="control-sidebar">
            <nav class="view-nav">
                <button class="nav-btn active">
                    <span class="nav-icon">📅</span>
                    <span>Monthly Grid</span>
                </button>
                <button class="nav-btn">
                    <span class="nav-icon">📊</span>
                    <span>Weekly View</span>
                </button>
                <button class="nav-btn">
                    <span class="nav-icon">😊</span>
                    <span>Mood Analysis</span>
                </button>
                <button class="nav-btn">
                    <span class="nav-icon">🏷️</span>
                    <span>Global Tags</span>
                </button>
            </nav>

            <div class="mood-key">
                <span class="key-title">MOOD KEY</span>
                <div class="key-item">
                    <span class="key-dot" style="background: rgba(244, 114, 182, 0.2);">✨</span>
                    <span>Great</span>
                </div>
                <div class="key-item">
                    <span class="key-dot" style="background: rgba(34, 197, 94, 0.2);">🌿</span>
                    <span>Peaceful</span>
                </div>
                <div class="key-item">
                    <span class="key-dot" style="background: rgba(245, 158, 11, 0.2);">☁️</span>
                    <span>Reflective</span>
                </div>
                <div class="key-item">
                    <span class="key-dot" style="background: rgba(249, 115, 22, 0.2);">🔥</span>
                    <span>Productive</span>
                </div>
            </div>

            <button class="new-entry-btn" @onclick='() => NavManager.NavigateTo("/diary")'>
                <span>+</span> New Entry
            </button>
        </aside>

        @if (_selectedEntry != null)
        {
            <aside class="preview-panel">
                <button class="close-preview" @onclick="ClosePreview">✕</button>

                <div class="preview-header">
                    @{
                        DateTime.TryParse(_selectedEntry.DateKey, out var entryDate);
                    }
                    <h3 class="preview-date">@entryDate.ToString("MMM d, yyyy")</h3>
                    <span class="preview-day">@entryDate.ToString("dddd").ToUpper() MORNING</span>
                </div>

                <div class="preview-mood">
                    <span class="mood-badge" style="background: @GetMoodColor(_selectedEntry.MoodCategory)">
                        @MoodData.GetMoodEmoji(_selectedEntry.PrimaryMood) @_selectedEntry.PrimaryMood
                    </span>
                    <span class="preview-time">@_selectedEntry.CreatedAt.ToString("h:mm tt")</span>
                </div>

                <h4 class="preview-title">@_selectedEntry.Title</h4>

                <p class="preview-content">
                    "@_selectedEntry.GetPlainTextSnippet(200)"
                </p>

                @if (_selectedEntry.GetTagsList().Any())
                {
                    <div class="preview-tags">
                        @foreach (var tag in _selectedEntry.GetTagsList().Take(3))
                        {
                            <span class="preview-tag">#@tag.ToLower()</span>
                        }
                    </div>
                }

                <div class="preview-actions">
                    <button class="action-btn share-btn">
                        <span>📤</span> Share
                    </button>
                    <button class="action-btn edit-btn" @onclick="EditSelectedEntry">
                        <span>✏️</span> Edit
                    </button>
                </div>

                <div class="preview-image">
                    <div class="image-placeholder">
                        <span>"Write to remember."</span>
                    </div>
                </div>
            </aside>
        }
    </div>
</div>

