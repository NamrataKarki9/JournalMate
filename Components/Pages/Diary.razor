@page "/diary"
@page "/diary/{DateParam}"
@using JournalMaui.Services
@using JournalMaui.Models
@inject JournalDatabase Db
@inject NavigationManager NavManager
@inject JournalMate.Services.AppCurrentState AppState
@inject IJSRuntime JS
@implements IDisposable

<div class="diary-page">
    <header class="diary-header">
        <div class="header-brand">
            <span class="brand-icon">📖</span>
            <span class="brand-name">JournalMate</span>
        </div>

        <div class="header-center">
            <button class="date-picker-btn" @onclick="() => _showDatePicker = !_showDatePicker">
                <span class="date-icon">📅</span>
                <span>@ActiveDate.ToString("dddd, MMM d, yyyy")</span>
                <span class="dropdown-arrow">▼</span>
            </button>
        </div>

        <div class="header-actions">
            <button class="btn-save" @onclick="SaveEntry" disabled="@_isSaving">
                @if (_isSaving)
                {
                    <span>Saving...</span>
                }
                else
                {
                    <span>Save Changes</span>
                }
            </button>
            <button class="btn-export" @onclick='() => NavManager.NavigateTo("/export")'>
                Export Journal
            </button>
        </div>
    </header>

    <div class="diary-content">
        <aside class="left-sidebar glass-card">
            <div class="calendar-section">
                <div class="calendar-header">
                    <span class="calendar-title">CALENDAR</span>
                    <div class="calendar-nav">
                        <button @onclick="PreviousMonth">◀</button>
                        <button @onclick="NextMonth">▶</button>
                    </div>
                </div>
                <div class="mini-calendar">
                    <div class="cal-weekdays">
                        @foreach (var day in new[] { "S", "M", "T", "W", "T", "F", "S" })
                        {
                            <span>@day</span>
                        }
                    </div>
                    <div class="cal-days">
                        @for (int i = 0; i < (int)_firstDayOfMonth.DayOfWeek; i++)
                        {
                            <span class="cal-day empty"></span>
                        }
                        @for (int day = 1; day <= _daysInMonth; day++)
                        {
                            var currentDay = day;
                            var isToday = _calendarMonth.Year == DateTime.Today.Year &&
                            _calendarMonth.Month == DateTime.Today.Month &&
                            currentDay == DateTime.Today.Day;
                            var isSelected = _calendarMonth.Year == ActiveDate.Year &&
                            _calendarMonth.Month == ActiveDate.Month &&
                            currentDay == ActiveDate.Day;
                            <span class="cal-day @(isToday ? "today" : "") @(isSelected ? "selected" : "")"
                                  @onclick="() => SelectCalendarDay(currentDay)">
                                @currentDay
                            </span>
                        }
                    </div>
                </div>
            </div>

            <div class="prompt-section">
                <span class="prompt-label">DAILY PROMPT</span>
                <p class="prompt-text">"@GetDailyPrompt()"</p>
                <button class="new-prompt-btn" @onclick="RefreshPrompt">
                    🔄 New Prompt
                </button>
            </div>
        </aside>

        <main class="editor-main">
            <div class="mood-bar">
                <span class="mood-question">How are you feeling?</span>
                <div class="mood-chips">
                    @foreach (var mood in _quickMoods)
                    {
                        <button class="mood-chip-sm @(SelectedPrimaryMood == mood ? "active" : "")"
                                @onclick="() => SelectPrimaryMood(mood)">
                            @mood
                        </button>
                    }
                </div>
                @if (!string.IsNullOrEmpty(_statusMessage))
                {
                    <span class="auto-save-status">@_statusMessage</span>
                }
            </div>

            <div class="editor-card glass-card">
                <div class="editor-content">
                    <input type="text" class="title-input" placeholder="Title of your entry..." @bind="EntryTitle"
                           @bind:event="oninput" />

                    <div id="quill-editor" class="quill-container"></div>
                </div>

                <div class="editor-footer">
                    <span class="word-stats">@_wordCount WORDS • @_readTime MINUTES READ</span>
                    @if (RecordCreationTime.HasValue)
                    {
                        <span class="last-edited">LAST EDITED: @RecordCreationTime.Value.ToString("h:mm tt")</span>
                    }
                </div>
            </div>
        </main>

        <aside class="right-sidebar">
            <div class="tags-section glass-card">
                <div class="section-header">
                    <span class="section-icon">🏷️</span>
                    <span class="section-title">TAGS</span>
                </div>
                <div class="tags-list">
                    @foreach (var tag in SelectedTags)
                    {
                        <span class="tag">
                            #@tag
                            <button class="tag-remove" @onclick="() => RemoveTag(tag)">×</button>
                        </span>
                    }
                </div>
                <div class="add-tag-row">
                    <input type="text" class="tag-input" placeholder="Add a tag..." @bind="_newTagInput"
                           @bind:event="oninput" @onkeydown="HandleTagKeyPress" />
                    <button class="add-tag-btn" @onclick="AddTag">+</button>
                </div>
            </div>

            <div class="category-section glass-card">
                <div class="section-header">
                    <span class="section-icon">📁</span>
                    <span class="section-title">CATEGORY</span>
                </div>
                <select class="category-select" @bind="SelectedCategory">
                    <option value="">Select category...</option>
                    @foreach (var cat in TagData.Categories)
                    {
                        <option value="@cat">@cat</option>
                    }
                </select>
            </div>

            <div class="ai-section glass-card">
                <span class="ai-icon">🤖</span>
                <p>Analyze sentiment with AI (coming soon)</p>
            </div>
        </aside>
    </div>
</div>

@if (_showDeleteConfirm)
{
    <div class="modal-overlay" @onclick="HideDeleteConfirm">
        <div class="modal-card glass-card" @onclick:stopPropagation="true">
            <h3>Delete Entry?</h3>
            <p>Are you sure you want to delete this entry? This cannot be undone.</p>
            <div class="modal-actions">
                <button class="btn-cancel" @onclick="HideDeleteConfirm">Cancel</button>
                <button class="btn-delete" @onclick="DeleteEntry">Delete</button>
            </div>
        </div>
    </div>
}

