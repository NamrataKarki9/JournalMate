@page "/diary"
@page "/diary/{DateParam}"
@using JournalMate.Services
@using JournalMaui.Models
@inject JournalDatabase Db
@inject NavigationManager NavManager
@inject JournalMate.Services.AppCurrentState AppState
@inject JournalMate.Services.ToastService ToastFactory
@inject IJSRuntime JS
@implements IDisposable

<div class="diary-page">
    <header class="diary-header">
        <div class="header-brand">
            <span class="brand-icon">📖</span>
            <span class="brand-name">JournalMate</span>
        </div>

        <div class="header-center">
            <button class="date-picker-btn" @onclick="() => _showDatePicker = !_showDatePicker">
                <span class="date-icon">📅</span>
                <span>@ActiveDate.ToString("dddd, MMM d, yyyy")</span>
                <span class="dropdown-arrow">▼</span>
            </button>
        </div>

        <div class="header-actions">
            <button class="btn-save" @onclick="SaveEntry" disabled="@(_isSaving || string.IsNullOrWhiteSpace(SelectedPrimaryMood))">
                @if (_isSaving)
                {
                    <span>Saving...</span>
                }
                else
                {
                    <span>Save Changes</span>
                }
            </button>
            <button class="btn-export" @onclick='() => NavManager.NavigateTo("/export")'>
                Export Journal
            </button>
        </div>
    </header>

    <div class="diary-content">
        <aside class="left-sidebar glass-card">
            <div class="calendar-section">
                <div class="calendar-header">
                    <span class="calendar-title">CALENDAR</span>
                    <div class="calendar-nav">
                        <button @onclick="PreviousMonth">◀</button>
                        <button @onclick="NextMonth">▶</button>
                    </div>
                </div>
                <div class="mini-calendar">
                    <div class="cal-weekdays">
                        @foreach (var day in new[] { "S", "M", "T", "W", "T", "F", "S" })
                        {
                            <span>@day</span>
                        }
                    </div>
                    <div class="cal-days">
                        @for (int i = 0; i < (int)_firstDayOfMonth.DayOfWeek; i++)
                        {
                            <span class="cal-day empty"></span>
                        }
                        @for (int day = 1; day <= _daysInMonth; day++)
                        {
                            var currentDay = day;
                            var isToday = _calendarMonth.Year == DateTime.Today.Year &&
                            _calendarMonth.Month == DateTime.Today.Month &&
                            currentDay == DateTime.Today.Day;
                            var isSelected = _calendarMonth.Year == ActiveDate.Year &&
                            _calendarMonth.Month == ActiveDate.Month &&
                            currentDay == ActiveDate.Day;
                            <span class="cal-day @(isToday ? "today" : "") @(isSelected ? "selected" : "")"
                                @onclick="() => SelectCalendarDay(currentDay)">
                                @currentDay
                            </span>
                        }
                    </div>
                </div>
            </div>

            <div class="prompt-section">
                <span class="prompt-label">DAILY PROMPT</span>
                <p class="prompt-text">"@GetDailyPrompt()"</p>
                <button class="new-prompt-btn" @onclick="RefreshPrompt">
                    🔄 New Prompt
                </button>
            </div>
        </aside>

        <main class="editor-main">
            <div class="editor-card glass-card">
                <div class="editor-content">
                    <input type="text" class="title-input" placeholder="Title of your entry..." @bind="EntryTitle"
                        @bind:event="oninput" disabled="@(string.IsNullOrWhiteSpace(SelectedPrimaryMood))" />

                    <div id="quill-editor" class="quill-container"></div>
                </div>

                @if (string.IsNullOrWhiteSpace(SelectedPrimaryMood))
                {
                    <div class="editor-blocker">
                        <div class="blocker-content">
                            <span class="blocker-icon">💭</span>
                            <h3>First, tell us: How are you feeling today?</h3>
                            <p>Select a mood from the sidebar to unlock your journal.</p>
                        </div>
                    </div>
                }

                <div class="editor-footer">
                    <span class="word-stats">@_wordCount WORDS • @_readTime MINUTES READ</span>
                    @if (RecordCreationTime.HasValue)
                    {
                        <span class="last-edited">LAST EDITED: @RecordCreationTime.Value.ToString("h:mm tt")</span>
                    }
                </div>
            </div>
        </main>

        <aside class="right-sidebar">
           <!-- Mood Selection Card -->
            <div class="glass-card mood-card">
                <h2 class="card-title">
                    <span>😊</span> How are you feeling today?
                </h2>
                
                <div class="category-grid">
                    <button class="category-card @(_selectedCategory == "Positive" ? "active" : "")" 
                            @onclick='() => _selectedCategory = "Positive"'>
                        <span class="emoji">😊</span>
                        <span class="label">Positive</span>
                    </button>
                    <button class="category-card @(_selectedCategory == "Neutral" ? "active" : "")" 
                            @onclick='() => _selectedCategory = "Neutral"'>
                        <span class="emoji">😐</span>
                        <span class="label">Neutral</span>
                    </button>
                    <button class="category-card @(_selectedCategory == "Negative" ? "active" : "")" 
                            @onclick='() => _selectedCategory = "Negative"'>
                        <span class="emoji">😔</span>
                        <span class="label">Negative</span>
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(_selectedCategory))
                {
                    <div class="secondary-mood-section">
                        <h3 class="secondary-title">Select your specific mood:</h3>
                        <div class="mood-grid">
                            @{
                                var moods = _selectedCategory switch {
                                    "Positive" => MoodData.Positive,
                                    "Neutral" => MoodData.Neutral,
                                    "Negative" => MoodData.Negative,
                                    _ => new List<string>()
                                };
                            }
                            @foreach (var mood in moods)
                            {
                                <button class="mood-chip @(SelectedPrimaryMood == mood ? "active" : "")"
                                        @onclick="() => SelectMood(mood)">
                                    <span class="emoji">@MoodData.GetMoodEmoji(mood)</span>
                                    <span class="label">@mood</span>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="tags-section glass-card">
                <div class="section-header">
                    <span class="section-icon">🏷️</span>
                    <span class="section-title">TAGS</span>
                </div>
                <div class="tags-list">
                    @foreach (var tag in SelectedTags)
                    {
                        <span class="tag">
                            #@tag
                            <button class="tag-remove" @onclick="() => RemoveTag(tag)">×</button>
                        </span>
                    }
                </div>
                <div class="add-tag-container">
                    <div class="add-tag-row">
                        <input type="text" class="tag-input" placeholder="Add a tag..." value="@_newTagInput"
                            @oninput="HandleTagInput" @onkeydown="HandleTagKeyPress"
                            @onfocus="() => _showTagSuggestions = true" @onblur="HandleTagInputBlur" />
                        <button class="add-tag-btn" @onclick="AddTag">+</button>
                    </div>
                    @if (_showTagSuggestions && _tagSuggestions.Any())
                    {
                        <div class="tag-suggestions">
                            @foreach (var suggestion in _tagSuggestions)
                            {
                                <div class="tag-suggestion-item" @onmousedown="() => SelectSuggestedTag(suggestion)">
                                    <span class="suggestion-icon">🏷️</span>
                                    <span class="suggestion-text">@suggestion</span>
                                    @if (TagData.IsPreBuiltTag(suggestion))
                                    {
                                        <span class="suggestion-badge">Built-in</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="category-section glass-card">
                <div class="section-header">
                    <span class="section-icon">📁</span>
                    <span class="section-title">CATEGORY</span>
                </div>
                <select class="category-select" @bind="SelectedCategory">
                    <option value="">Select category...</option>
                    @foreach (var cat in TagData.Categories)
                    {
                        <option value="@cat">@cat</option>
                    }
                </select>
            </div>
        </aside>
    </div>
</div>

@if (_showDeleteConfirm)
{
    <div class="modal-overlay" @onclick="HideDeleteConfirm">
        <div class="modal-card glass-card" @onclick:stopPropagation="true">
            <h3>Delete Entry?</h3>
            <p>Are you sure you want to delete this entry? This cannot be undone.</p>
            <div class="modal-actions">
                <button class="btn-cancel" @onclick="HideDeleteConfirm">Cancel</button>
                <button class="btn-delete" @onclick="DeleteEntry">Delete</button>
            </div>
        </div>
    </div>
}

<style>
    .diary-page {
        min-height: 100vh;
        background: var(--jm-bg-primary);
        display: flex;
        flex-direction: column;
    }

    .diary-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 24px;
        background: var(--jm-surface-solid);
        border-bottom: 1px solid var(--jm-border);
    }

    .header-brand {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .brand-icon {
        font-size: 24px;
    }

    .brand-name {
        font-size: 18px;
        font-weight: 700;
        color: var(--jm-text-primary);
    }

    .date-picker-btn {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 20px;
        background: var(--jm-surface);
        border: 1px solid var(--jm-border);
        border-radius: var(--jm-radius-full);
        color: var(--jm-text-primary);
        font-size: 14px;
        cursor: pointer;
        transition: all var(--jm-transition-fast);
    }

    .date-picker-btn:hover {
        border-color: var(--jm-accent);
    }

    .dropdown-arrow {
        font-size: 10px;
        color: var(--jm-text-muted);
    }

    .header-actions {
        display: flex;
        gap: 12px;
    }

    .btn-save {
        padding: 10px 24px;
        background: var(--jm-accent);
        color: white;
        border: none;
        border-radius: var(--jm-radius-md);
        font-weight: 600;
        cursor: pointer;
        transition: all var(--jm-transition-fast);
    }

    .btn-save:hover {
        background: var(--jm-accent-dark);
    }

    .btn-export {
        padding: 10px 24px;
        background: transparent;
        color: var(--jm-text-secondary);
        border: 1px solid var(--jm-border);
        border-radius: var(--jm-radius-md);
        font-weight: 500;
        cursor: pointer;
        transition: all var(--jm-transition-fast);
    }

    .btn-export:hover {
        background: var(--jm-surface);
    }

    .btn-delete-header {
        padding: 10px 16px;
        background: rgba(239, 68, 68, 0.1);
        color: var(--jm-error);
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: var(--jm-radius-md);
        font-size: 16px;
        cursor: pointer;
        transition: all var(--jm-transition-fast);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-delete-header:hover {
        background: rgba(239, 68, 68, 0.2);
        transform: translateY(-1px);
    }

    .btn-delete-header {
        padding: 10px 16px;
        background: rgba(239, 68, 68, 0.1);
        color: var(--jm-error);
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: var(--jm-radius-md);
        font-size: 16px;
        cursor: pointer;
        transition: all var(--jm-transition-fast);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-delete-header:hover {
        background: rgba(239, 68, 68, 0.2);
        transform: translateY(-1px);
    }

    .btn-delete-header {
        padding: 10px 16px;
        background: rgba(239, 68, 68, 0.1);
        color: var(--jm-error);
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: var(--jm-radius-md);
        font-size: 16px;
        cursor: pointer;
        transition: all var(--jm-transition-fast);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-delete-header:hover {
        background: rgba(239, 68, 68, 0.2);
        transform: translateY(-1px);
    }

    .diary-content {
        flex: 1;
        display: grid;
        grid-template-columns: 220px 1fr 280px;
        gap: 0;
        height: calc(100vh - 68px);
    }

    .left-sidebar {
        padding: 20px;
        border-radius: 0;
        border: none;
        border-right: 1px solid var(--jm-border);
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .calendar-section .calendar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

    .calendar-title,
    .prompt-label {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1px;
        color: var(--jm-accent-light);
    }

    .calendar-nav button {
        background: none;
        border: none;
        color: var(--jm-text-muted);
        cursor: pointer;
        padding: 4px 8px;
    }

    .mini-calendar {
        font-size: 12px;
    }

    .cal-weekdays {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        text-align: center;
        color: var(--jm-text-muted);
        margin-bottom: 8px;
    }

    .cal-days {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 4px;
    }

    .cal-day {
        aspect-ratio: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--jm-radius-sm);
        cursor: pointer;
        color: var(--jm-text-secondary);
        transition: all var(--jm-transition-fast);
    }

    .cal-day:hover:not(.empty) {
        background: var(--jm-surface-hover);
    }

    .cal-day.today {
        background: var(--jm-accent);
        color: white;
    }

    .cal-day.selected {
        border: 2px solid var(--jm-accent);
    }

    .cal-day.empty {
        cursor: default;
    }

    .prompt-section {
        border-top: 1px solid var(--jm-border);
        padding-top: 20px;
    }

    .prompt-text {
        font-size: 14px;
        color: var(--jm-text-secondary);
        font-style: italic;
        line-height: 1.5;
        margin: 12px 0;
    }

    .new-prompt-btn {
        background: none;
        border: none;
        color: var(--jm-accent-light);
        font-size: 13px;
        cursor: pointer;
    }

    .editor-main {
        display: flex;
        flex-direction: column;
        padding: 24px;
        overflow-y: auto;
    }

    .mood-bar {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .mood-question {
        font-size: 14px;
        color: var(--jm-text-secondary);
    }

    .mood-chips {
        display: flex;
        gap: 8px;
    }

    .mood-chip-sm {
        padding: 8px 16px;
        background: var(--jm-surface);
        border: 1px solid var(--jm-border);
        border-radius: var(--jm-radius-full);
        color: var(--jm-text-secondary);
        font-size: 13px;
        cursor: pointer;
        transition: all var(--jm-transition-fast);
    }

    .mood-chip-sm:hover {
        border-color: var(--jm-accent);
        color: var(--jm-text-primary);
    }

    .mood-chip-sm.active {
        background: var(--jm-accent);
        border-color: var(--jm-accent);
        color: white;
    }

    .auto-save-status {
        font-size: 12px;
        color: var(--jm-success);
        margin-left: auto;
    }

    .editor-card {
        flex: 1;
        display: flex;
        flex-direction: column;
        padding: 0;
        overflow: hidden;
        border: 1px solid var(--jm-border) !important;
        background: var(--jm-bg-secondary) !important;
        transition: all var(--jm-transition-fast);
        position: relative; /* CRITICAL for blocker */
    }

    .editor-card:focus-within {
        border-color: var(--jm-accent) !important;
        box-shadow: 0 0 20px rgba(147, 51, 234, 0.15);
    }

    .editor-content {
        flex: 1;
        padding: 24px;
        display: flex;
        flex-direction: column;
        overflow-y: auto;
    }

    .editor-blocker {
        position: absolute;
        inset: 0;
        background: var(--jm-bg-primary); /* Use primary background to fully hide */
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000; /* Extremely high to cover everything */
        border-radius: var(--jm-radius-md);
        animation: fadeIn 0.4s ease;
        backdrop-filter: blur(10px);
    }

    .blocker-content {
        text-align: center;
        padding: 40px;
        max-width: 400px;
    }

    .blocker-icon {
        font-size: 48px;
        display: block;
        margin-bottom: 24px;
        animation: bounce 2s infinite ease-in-out;
    }

    .blocker-content h3 {
        color: var(--jm-text-primary);
        font-size: 20px;
        margin-bottom: 12px;
    }

    .blocker-content p {
        color: var(--jm-text-muted);
        font-size: 14px;
        line-height: 1.6;
    }

    @@keyframes bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .title-input {
        background: transparent;
        border: none;
        border-bottom: 2px solid transparent;
        font-size: 28px;
        font-weight: 600;
        color: var(--jm-text-primary);
        outline: none;
        margin-bottom: 16px;
        padding: 8px 0;
        width: 100%;
        transition: all var(--jm-transition-fast);
    }

    .title-input:focus {
        border-bottom-color: var(--jm-accent);
        color: var(--jm-accent-light);
    }

    .title-input::placeholder {
        color: var(--jm-text-muted);
        font-weight: 400;
    }

    /* Quill Editor Styles */
    .quill-container {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 400px;
    }

    ::deep .ql-container {
        flex: 1;
        font-size: 16px;
        line-height: 1.8;
        border: none !important;
    }

    ::deep .ql-editor {
        color: var(--jm-text-primary);
        padding: 0;
        min-height: 300px;
    }

    ::deep .ql-editor.ql-blank::before {
        color: var(--jm-text-muted);
        font-style: normal;
    }

    ::deep .ql-toolbar {
        border: none !important;
        border-bottom: 1px solid var(--jm-border) !important;
        background: var(--jm-surface);
        padding: 12px 8px;
        margin: -24px -24px 16px -24px;
    }

    ::deep .ql-toolbar button {
        color: var(--jm-text-secondary);
    }

    ::deep .ql-toolbar button:hover,
    ::deep .ql-toolbar button.ql-active {
        color: var(--jm-accent);
    }

    ::deep .ql-stroke {
        stroke: var(--jm-text-secondary);
    }

    ::deep .ql-toolbar button:hover .ql-stroke,
    ::deep .ql-toolbar button.ql-active .ql-stroke {
        stroke: var(--jm-accent);
    }

    ::deep .ql-fill {
        fill: var(--jm-text-secondary);
    }

    ::deep .ql-toolbar button:hover .ql-fill,
    ::deep .ql-toolbar button.ql-active .ql-fill {
        fill: var(--jm-accent);
    }

    .editor-footer {
        display: flex;
        justify-content: space-between;
        padding: 12px 24px;
        border-top: 1px solid var(--jm-border);
        font-size: 11px;
        color: var(--jm-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* CRITICAL FIX: Right sidebar must have proper stacking context */
    .right-sidebar {
        padding: 20px;
        border-left: 1px solid var(--jm-border);
        display: flex;
        flex-direction: column;
        gap: 16px;
        overflow-y: auto;
        position: relative;
        /* CRITICAL: Create stacking context for entire sidebar */
        isolation: isolate;
        /* ADDED: Create new stacking context */
    }

    .right-sidebar .glass-card {
        padding: 16px;
        border-radius: var(--jm-radius-md);
        flex-shrink: 0;
    }

    .section-header {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 12px;
    }

    .section-icon {
        font-size: 14px;
    }

    .section-title {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1px;
        color: var(--jm-accent-light);
    }

    .tags-list {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 12px;
        min-height: 24px;
    }

    .tag {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 10px;
        background: rgba(147, 51, 234, 0.15);
        border-radius: var(--jm-radius-full);
        font-size: 12px;
        color: var(--jm-accent-light);
    }

    .tag-remove {
        background: none;
        border: none;
        color: inherit;
        cursor: pointer;
        font-size: 14px;
        padding: 0;
    }

    /* CRITICAL FIX: Tags section stacking */
    .tags-section {
        position: relative;
        /* CRITICAL: Must have position */
        z-index: 100;
        /* VERY HIGH: Above everything in sidebar */
    }

    /* CRITICAL FIX: Tag autocomplete container */
    .add-tag-container {
        position: relative;
        /* CRITICAL: Must have position for absolute children */
        margin-bottom: 12px;
    }

    .add-tag-row {
        display: flex;
        gap: 8px;
        position: relative;
        /* ADDED: Ensure proper positioning */
        z-index: 1;
    }

    .tag-input {
        flex: 1;
        padding: 8px 12px;
        background: var(--jm-surface);
        border: 1px solid var(--jm-border);
        border-radius: var(--jm-radius-sm);
        color: var(--jm-text-primary);
        font-size: 13px;
        outline: none;
        transition: all var(--jm-transition-fast);
    }

    .tag-input:focus {
        border-color: var(--jm-accent);
    }

    .add-tag-btn {
        width: 32px;
        height: 32px;
        background: var(--jm-accent);
        border: none;
        border-radius: var(--jm-radius-sm);
        color: white;
        font-size: 18px;
        cursor: pointer;
        transition: all var(--jm-transition-fast);
    }

    .add-tag-btn:hover {
        background: var(--jm-accent-dark);
    }

    /* CRITICAL FIX: Tag suggestions dropdown - MUST be on top */
    .tag-suggestions {
        position: absolute;
        /* CRITICAL: Absolute positioning */
        top: 100%;
        /* CRITICAL: Position below input */
        left: 0;
        right: 0;
        margin-top: 4px;
        background: var(--jm-surface-solid);
        border: 1px solid var(--jm-accent);
        /* CHANGED: More visible border */
        border-radius: var(--jm-radius-sm);
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
        /* ENHANCED: Stronger shadow */
        max-height: 200px;
        overflow-y: auto;
        z-index: 9999 !important;
        /* CRITICAL: Maximum z-index with !important */
    }

    .tag-suggestion-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 12px;
        cursor: pointer;
        transition: all var(--jm-transition-fast);
        border-bottom: 1px solid var(--jm-border-light);
        background: var(--jm-surface-solid);
        /* ADDED: Ensure solid background */
    }

