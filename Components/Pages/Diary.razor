@code {
    [Parameter] public string? DateParam { get; set; }

    private DateTime ActiveDate = DateTime.Today;
    private DateTime _calendarMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime _firstDayOfMonth => new DateTime(_calendarMonth.Year, _calendarMonth.Month, 1);
    private int _daysInMonth => DateTime.DaysInMonth(_calendarMonth.Year, _calendarMonth.Month);

    private string EntryTitle = "";
    private string JournalContent = "";
    private string SelectedPrimaryMood = "";
    private string SelectedSecondaryMood1 = "";
    private string SelectedSecondaryMood2 = "";
    private string SelectedCategory = "";
    private List<string> SelectedTags = new();
    private int? LoadedEntryId = null;
    private DateTime? RecordCreationTime = null;

    private string _newTagInput = "";
    private List<string> _tagSuggestions = new();
    private bool _showTagSuggestions = false;
    private List<string> _userCustomTags = new();

    private int _wordCount = 0;
    private int _readTime = 0;
    private bool _isSaving = false;
    private bool _showDeleteConfirm = false;
    private bool _showDatePicker = false;
    private int _promptIndex = 0;
    private bool _quillInitialized = false;
    private string _selectedCategory = "";

    private readonly string[] _quickMoods = { "Radiant", "Calm", "Reflective", "Tired" };
    private readonly string[] _dailyPrompts = {
"What is one small thing that brought you joy today, and why did it stand out?",
"Describe a moment today when you felt truly present.",
"What are you grateful for right now?",
"What challenge did you face today and how did you handle it?",
"What would make tomorrow even better than today?"
};

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += StateHasChanged;
        AppState.OnDataChanged += HandleDataChanged;

        if (!string.IsNullOrEmpty(DateParam) && DateTime.TryParse(DateParam, out var parsedDate))
        {
            ActiveDate = parsedDate;
        }

        await LoadEntryForDate();
        await LoadCustomTags();

        if (!string.IsNullOrEmpty(AppState.GlobalMood))
        {
            SelectedPrimaryMood = AppState.GlobalMood;
            AppState.SetGlobalMood("");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("QuillEditor.init", "quill-editor");
                _quillInitialized = true;

                if (!string.IsNullOrEmpty(JournalContent))
                {
                    await JS.InvokeVoidAsync("QuillEditor.setContent", "quill-editor", JournalContent);
                }

                await UpdateWordCountFromQuill();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error initializing Quill: {ex.Message}");
            }
        }
    }

    private async void HandleDataChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadEntryForDate();
            StateHasChanged();
        });
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(DateParam) && DateTime.TryParse(DateParam, out var parsedDate))
        {
            if (parsedDate != ActiveDate)
            {
                ActiveDate = parsedDate;
                await LoadEntryForDate();
            }
        }
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
        AppState.OnDataChanged -= HandleDataChanged;

        if (_quillInitialized)
        {
            try
            {
                JS.InvokeVoidAsync("QuillEditor.destroy", "quill-editor");
            }
            catch { }
        }
    }

    private async Task LoadCustomTags()
    {
        try
        {
            var tagFrequency = await Db.GetTagFrequencyAsync();
            _userCustomTags = tagFrequency.Keys.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading custom tags: {ex.Message}");
        }
    }

    private async Task LoadEntryForDate()
    {
        var entry = await Db.GetByDateAsync(ActiveDate);
        if (entry != null)
        {
            EntryTitle = entry.Title;
            JournalContent = entry.Content;
            SelectedPrimaryMood = entry.PrimaryMood;
            SelectedSecondaryMood1 = entry.SecondaryMood1;
            SelectedSecondaryMood2 = entry.SecondaryMood2;
            SelectedCategory = entry.Category;
            SelectedTags = entry.GetTagsList();
            LoadedEntryId = entry.Id;
            RecordCreationTime = entry.UpdatedAt;
            _selectedCategory = MoodData.GetMoodCategory(SelectedPrimaryMood);

            if (_quillInitialized)
            {
                await JS.InvokeVoidAsync("QuillEditor.setContent", "quill-editor", JournalContent);
                await UpdateWordCountFromQuill();
            }
        }
        else
        {
            await ResetForm();
        }
    }

    private async Task ResetForm()
    {
        EntryTitle = "";
        JournalContent = "";
        SelectedPrimaryMood = "";
        SelectedSecondaryMood1 = "";
        SelectedSecondaryMood2 = "";
        SelectedCategory = "";
        SelectedTags = new();
        LoadedEntryId = null;
        RecordCreationTime = null;
        _selectedCategory = "";

        if (_quillInitialized)
        {
            await JS.InvokeVoidAsync("QuillEditor.setContent", "quill-editor", "");
            await UpdateWordCountFromQuill();
        }
    }

    private async Task UpdateWordCountFromQuill()
    {
        if (!_quillInitialized) return;

        try
        {
            var text = await JS.InvokeAsync<string>("QuillEditor.getText", "quill-editor");
            if (string.IsNullOrWhiteSpace(text))
            {
                _wordCount = 0;
                _readTime = 0;
            }
            else
            {
                _wordCount = text.Split(new[] { ' ', '\n', '\r', '\t' }, StringSplitOptions.RemoveEmptyEntries).Length;
                _readTime = Math.Max(1, _wordCount / 200);
            }
            StateHasChanged();
        }
        catch { }
    }


    private void SelectMood(string mood)
    {
        SelectedPrimaryMood = mood;
        StateHasChanged();
    }

    private async Task SaveEntry()
    {
        if (string.IsNullOrWhiteSpace(SelectedPrimaryMood))
        {
            ToastFactory.ShowToast("Please select a mood before saving.", ToastType.Warning);
            return;
        }

        _isSaving = true;

        try
        {
            if (_quillInitialized)
            {
                JournalContent = await JS.InvokeAsync<string>("QuillEditor.getContent", "quill-editor");
            }

            var entry = new JournalEntry
            {
                DateKey = ActiveDate.ToString("yyyy-MM-dd"),
                Title = string.IsNullOrWhiteSpace(EntryTitle) ? $"Entry for {ActiveDate:MMM d, yyyy}" : EntryTitle,
                Content = JournalContent,
                PrimaryMood = SelectedPrimaryMood,
                SecondaryMood1 = SelectedSecondaryMood1,
                SecondaryMood2 = SelectedSecondaryMood2,
                Category = SelectedCategory,
                Tags = string.Join(",", SelectedTags)
            };

            await Db.SaveAsync(entry);
            ToastFactory.ShowToast("Changes saved successfully!", ToastType.Success);
            RecordCreationTime = DateTime.Now;

            await UpdateWordCountFromQuill();
            await LoadCustomTags();
        }
        catch (Exception ex)
        {
            ToastFactory.ShowToast($"Failed to save: {ex.Message}", ToastType.Error);
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private void HandleTagInput(ChangeEventArgs e)
    {
        var input = e.Value?.ToString() ?? "";
        // Remove digits
        _newTagInput = new string(input.Where(c => !char.IsDigit(c)).ToArray());
        
        if (input != _newTagInput)
        {
             ToastFactory.ShowToast("Numbers are not allowed in tags.", ToastType.Warning);
        }
        
        UpdateTagSuggestions();
    }

    private void UpdateTagSuggestions()
    {
        if (string.IsNullOrWhiteSpace(_newTagInput))
        {
            _tagSuggestions = new List<string>();
            return;
        }

        var query = _newTagInput.Trim();

        var predefinedMatches = TagData.SearchTags(query);

        var customMatches = _userCustomTags
        .Where(t => t.Contains(query, StringComparison.OrdinalIgnoreCase))
        .Where(t => !SelectedTags.Contains(t))
        .ToList();

        _tagSuggestions = predefinedMatches
        .Concat(customMatches)
        .Distinct()
        .Where(t => !SelectedTags.Contains(t))
        .Take(8)
        .ToList();

        _showTagSuggestions = _tagSuggestions.Any();
    }

    private void SelectSuggestedTag(string tag)
    {
        if (!SelectedTags.Contains(tag))
        {
            SelectedTags.Add(tag);
            _newTagInput = "";
            _tagSuggestions = new List<string>();
            _showTagSuggestions = false;
        }
    }

    private void HandleTagInputBlur()
    {
        Task.Delay(200).ContinueWith(_ =>
        {
            InvokeAsync(() =>
    {
            _showTagSuggestions = false;
            StateHasChanged();
        });
        });
    }

    private void AddTag()
    {
        // Extra validation
        if (_newTagInput.Any(char.IsDigit))
        {
             ToastFactory.ShowToast("Tags cannot contain numbers.", ToastType.Warning);
             return;
        }

        if (!string.IsNullOrWhiteSpace(_newTagInput) && !SelectedTags.Contains(_newTagInput))
        {
            SelectedTags.Add(_newTagInput.Trim());
            _newTagInput = "";
            _tagSuggestions = new List<string>();
            _showTagSuggestions = false;
        }
    }

    private void RemoveTag(string tag)
    {
        SelectedTags.Remove(tag);
    }

    private void HandleTagKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddTag();
        }
        else if (e.Key == "Escape")
        {
            _showTagSuggestions = false;
            _tagSuggestions = new List<string>();
        }
    }

    private void SelectCalendarDay(int day)
    {
        ActiveDate = new DateTime(_calendarMonth.Year, _calendarMonth.Month, day);
        _ = LoadEntryForDate();
    }

    private void PreviousMonth()
    {
        _calendarMonth = _calendarMonth.AddMonths(-1);
    }

    private void NextMonth()
    {
        if (_calendarMonth < new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1))
        {
            _calendarMonth = _calendarMonth.AddMonths(1);
        }
    }

    private string GetDailyPrompt()
    {
        return _dailyPrompts[_promptIndex % _dailyPrompts.Length];
    }

    private void RefreshPrompt()
    {
        _promptIndex = (_promptIndex + 1) % _dailyPrompts.Length;
    }

    private void ShowDeleteConfirmation() => _showDeleteConfirm = true;
    private void HideDeleteConfirm() => _showDeleteConfirm = false;

    private async Task DeleteEntry()
    {
        try
        {
            if (LoadedEntryId.HasValue)
            {
                await Db.DeleteByIdAsync(LoadedEntryId.Value);
            }
            else
            {
                await Db.DeleteAsync(ActiveDate);
            }
            ToastFactory.ShowToast("Data deleted successfully", ToastType.Success);
            _showDeleteConfirm = false;
            await ResetForm();
        }
        catch (Exception ex)
        {
            ToastFactory.ShowToast($"Failed to delete: {ex.Message}", ToastType.Error);
        }
    }
}